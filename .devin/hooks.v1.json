{
  "PostToolUse": [
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "./.devin/scripts/mark-edit.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "./.devin/scripts/require-dod-gate.sh",
          "timeout": 5
        }
      ]
    }
  ]
}
