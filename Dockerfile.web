# ── Stage 1: Dependencies ─────────────────────────────────────────────
FROM oven/bun:1.3.13 AS deps

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    BUN_JSC_forceRAMSize=4294967296

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# ── Stage 2: Build ────────────────────────────────────────────────────
FROM oven/bun:1.3.13 AS build

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    BUN_JSC_forceRAMSize=4294967296

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_DIRECT_UPLOAD_MAX_BYTES=1073741824
ARG NEXT_PUBLIC_ENGINE_URL
# Next.js inlines NEXT_PUBLIC_* at build time (also in server bundles), so the
# Sentry DSN must arrive as a build arg — a runtime-only env var is ignored.
ARG NEXT_PUBLIC_SENTRY_DSN=
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_DIRECT_UPLOAD_MAX_BYTES=$NEXT_PUBLIC_DIRECT_UPLOAD_MAX_BYTES \
    NEXT_PUBLIC_ENGINE_URL=$NEXT_PUBLIC_ENGINE_URL

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN bun --smol run build

# Post-deploy smoke test (server/deploy/netcup/RUNBOOK.md). The runner has
# neither scripts/ nor src/, so the script is bundled with the libraries it
# reuses into one self-contained file.
RUN bun build scripts/post-deploy-smoke.ts --target=bun --outfile=/app/.ops/post-deploy-smoke.js

# The build cache is only useful for the NEXT build, never at runtime. Copying
# it into the image added ~2.9 GB per release and filled the server's disk.
RUN rm -rf .next/cache

# Prune dev dependencies for the runner stage
RUN bun install --frozen-lockfile --production

# ── Stage 3: Runner ───────────────────────────────────────────────────
FROM oven/bun:1.3.13 AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

# Copy only production artifacts
COPY --from=build --chown=bun:bun /app/.next ./.next
COPY --from=build --chown=bun:bun /app/public ./public
COPY --from=build --chown=bun:bun /app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /app/package.json ./package.json
COPY --from=build --chown=bun:bun /app/next.config.ts ./next.config.ts
COPY --from=build --chown=bun:bun /app/tsconfig.json ./tsconfig.json
COPY --from=build --chown=bun:bun /app/components.json ./components.json
COPY --from=build --chown=bun:bun /app/bun.lock ./bun.lock
# Read at runtime by src/lib/corpus-meta.ts (join(cwd, "src/lib/corpus-meta.json")).
# The image is not a Next standalone build, so outputFileTracingIncludes does not
# ship it — without this line every citation check fails with ENOENT.
COPY --from=build --chown=bun:bun /app/src/lib/corpus-meta.json ./src/lib/corpus-meta.json
# Operator tool, run after each deploy:
#   docker exec subsumio-engine-web-1 bun scripts/post-deploy-smoke.js
COPY --from=build --chown=bun:bun /app/.ops/post-deploy-smoke.js ./scripts/post-deploy-smoke.js

# Persistent runtime state (file-backed stores: feature flags, SCIM status,
# WhatsApp media, admin backups, dashboard widgets, …). The netcup compose
# mounts the named volume web-data here; a fresh named volume inherits this
# directory's bun ownership, so the unprivileged runner can write to it.
RUN mkdir -p /app/.data && chown bun:bun /app/.data
ENV SUBSUMIO_DATA_DIR=/app/.data

USER bun

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD bun -e "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "run", "start"]

# Last on purpose: a per-deploy value here keeps every layer above cached.
# The commit this image was built from (set by server/deploy/netcup/deploy-code.sh).
# Without it the label inherited from the base image named a foreign revision.
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA
