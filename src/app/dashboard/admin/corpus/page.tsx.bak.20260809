"use client";

import { useQuery, useMutation } from "@tanstack/react-query";
import { useState } from "react";
import {
  AreaChart,
  Area,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  LineChart,
  Line,
  Legend,
} from "recharts";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@/components/ui/tabs";
import { CorpusStewardTab } from "@/components/dashboard/corpus-steward/CorpusStewardTab";
import { CorpusCommandCenter } from "@/components/dashboard/corpus-command-center";
import { ChunkInspector } from "@/components/dashboard/chunk-inspector";
import { ChunkQuality } from "@/components/dashboard/chunk-quality";
import {
  Database,
  Layers,
  Box,
  AlertTriangle,
  CheckCircle2,
  XCircle,
  RefreshCw,
  Activity,
  FileText,
  Search,
  Zap,
  Target,
  Wrench,
  ShieldCheck,
  Download,
  Save,
} from "lucide-react";
import { PageHeader } from "@/components/dashboard/page-header";
import { useLang } from "@/lib/use-lang";

// ─── Types ───────────────────────────────────────────────────────────────

interface CorpusStats {
  corpus: {
    total_pages: number;
    total_chunks: number;
    embedded_chunks: number;
    stale_chunks: number;
    embedding_coverage_pct: number;
    orphan_pages: number;
    chunks_per_page: number;
  };
  embedding: {
    chunks_by_model: Record<string, number>;
    stale_chunks: number;
    coverage_pct: number;
  };
  chunking: {
    chunker_versions: Array<{ version: string; count: number }>;
    page_types: Array<{ type: string; count: number }>;
    chunk_size_distribution: {
      undersized: number;
      small: number;
      optimal: number;
      large: number;
      oversized: number;
    };
    avg_chunk_chars: number;
    min_chunk_chars: number;
    max_chunk_chars: number;
  };
  per_source: Array<{
    source: string;
    pages: number;
    chunks: number;
    embedded: number;
    stale: number;
    coverage_pct: number;
  }>;
  search_telemetry: {
    total_calls_7d: number;
    cache_hit_rate_7d: number;
    avg_results_7d: number;
    avg_rank1_score: number | null;
    rank1_distribution: { lt_solid: number; solid: number; high: number } | null;
    intent_distribution: Record<string, number> | null;
  } | null;
  amendments: {
    total_30d: number;
    by_change_type: { added: number; modified: number; removed: number };
    by_jurisdiction: Record<string, number>;
    statutes_affected: number;
    unresolved_stale_outputs: number;
  } | null;
  hallucination: {
    total_traces: number;
    guardrail_pass_rate: number;
    cross_verify_clean_rate: number;
    hallucination_rate: number;
    regeneration_rate: number;
    avg_confidence: number | null;
    low_confidence_rate: number;
    provenance_coverage: number;
  } | null;
  snapshots: {
    current: number;
    jurisdictions: string[];
    newest: string | null;
  } | null;
  hnsw_index_exists: boolean;
  health: {
    score: number;
    status: "healthy" | "warnings" | "unhealthy";
    checks: Array<{
      name: string;
      status: "ok" | "warn" | "fail";
      message: string;
      value?: number;
      threshold?: number;
    }>;
  };
  generated_at: string;
}

interface ChunkQuality {
  rechunk_recommendations: Array<{
    source: string;
    version: string;
    page_count: number;
    chunk_count: number;
    recommendation: string;
    priority: "high" | "medium" | "low";
  }>;
  rechunk_queue: Array<{
    source: string;
    total_pages: number;
    total_chunks: number;
    versions: string;
  }>;
  histogram_by_version: Array<{
    chunker_version: string;
    undersized: number;
    small: number;
    optimal: number;
    large: number;
    oversized: number;
  }>;
  oversized_samples: Array<{
    slug: string;
    chunk_index: number;
    char_length: number;
    source_id: string;
  }>;
  undersized_samples: Array<{
    slug: string;
    chunk_index: number;
    char_length: number;
    source_id: string;
  }>;
  boundary_cohesion: {
    total_checked: number;
    clean_endings: number;
    mid_sentence: number;
    cohesion_pct: number;
    samples: Array<{ slug: string; chunk_index: number; ending_chars: string }>;
  };
  summary: {
    total_oversized: number;
    total_undersized: number;
    total_rechunk_pages: number;
    current_legal_version: number;
    current_markdown_version: number;
  };
  generated_at: string;
}

interface PipelineHealth {
  status: "healthy" | "degraded" | "unhealthy";
  engine: {
    status: "ok" | "degraded" | "error" | "unreachable";
    jobs?: { pending: number; active: number; failed_1h: number };
    outbox_exhausted?: number;
    docs_failed?: number;
  };
  db: {
    active_connections: number;
    idle_connections: number;
    waiting_on_locks: number;
  };
  hnsw_index_exists: boolean;
  pending_embeddings: number;
  checks: Array<{ name: string; status: "ok" | "warn" | "fail"; message: string }>;
  generated_at: string;
}

// ─── Helpers ─────────────────────────────────────────────────────────────

function formatNumber(n: number | undefined | null): string {
  if (n === undefined || n === null) return "—";
  return n.toLocaleString("de-DE");
}

function healthBadge(status: "healthy" | "warnings" | "unhealthy" | "degraded") {
  switch (status) {
    case "healthy":
      return <Badge className="bg-[color:var(--ds-success-bg)] text-[color:var(--ds-success-text)]">Gesund</Badge>;
    case "warnings":
    case "degraded":
      return <Badge className="bg-[color:var(--ds-warning-bg)] text-[color:var(--ds-warning-text)]">Warnungen</Badge>;
    case "unhealthy":
      return <Badge className="bg-[color:var(--ds-danger-bg)] text-[color:var(--ds-danger-text)]">Kritisch</Badge>;
  }
}

function downloadReportCSV(stats: CorpusStats) {
  const rows: string[] = [
    "Source,Pages,Chunks,Embedded,Stale,Coverage%",
    ...stats.per_source.map(
      (s) => `${s.source},${s.pages},${s.chunks},${s.embedded},${s.stale},${s.coverage_pct}`
    ),
  ];
  const blob = new Blob([rows.join("\n")], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `corpus-report-${new Date().toISOString().slice(0, 10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

function checkIcon(status: "ok" | "warn" | "fail") {
  switch (status) {
    case "ok":
      return <CheckCircle2 className="h-4 w-4 text-[color:var(--ds-success-text)]" />;
    case "warn":
      return <AlertTriangle className="h-4 w-4 text-[color:var(--ds-warning-text)]" />;
    case "fail":
      return <XCircle className="h-4 w-4 text-[color:var(--ds-danger-text)]" />;
  }
}

function priorityBadge(priority: "high" | "medium" | "low") {
  switch (priority) {
    case "high":
      return <Badge className="bg-[color:var(--ds-danger-bg)] text-[color:var(--ds-danger-text)]">Hoch</Badge>;
    case "medium":
      return <Badge className="bg-[color:var(--ds-warning-bg)] text-[color:var(--ds-warning-text)]">Mittel</Badge>;
    case "low":
      return <Badge className="bg-[color:var(--ds-info-bg)] text-[color:var(--ds-info-text)]">Niedrig</Badge>;
  }
}

// Bar chart component for chunk size distribution
function SizeBar({
  label,
  count,
  total,
  color,
}: {
  label: string;
  count: number;
  total: number;
  color: string;
}) {
  const pct = total > 0 ? (count / total) * 100 : 0;
  return (
    <div className="flex items-center gap-3">
      <div className="w-28 shrink-0 text-xs text-[color:var(--ds-text-subtle)]">{label}</div>
      <div className="relative h-6 flex-1 rounded bg-[color:var(--ds-surface-hover)]">
        <div
          className={`absolute top-0 left-0 h-full rounded ${color}`}
          style={{ width: `${Math.max(pct, 1)}%` }}
        />
        <span className="absolute top-1/2 right-2 -translate-y-1/2 text-xs font-medium">
          {formatNumber(count)} ({pct.toFixed(1)}%)
        </span>
      </div>
    </div>
  );
}

// ─── Page Component ──────────────────────────────────────────────────────

export default function CorpusDashboardPage() {
  const { t } = useLang();
  const [activeTab, setActiveTab] = useState("command-center");
  const [selectedSource, setSelectedSource] = useState<string | null>(null);

  const corpusQuery = useQuery<CorpusStats>({
    queryKey: ["corpus-stats"],
    queryFn: async () => {
      const res = await fetch("/api/monitoring/corpus-stats");
      if (!res.ok) throw new Error("Failed to fetch corpus stats");
      const json = await res.json();
      return json.data ?? json;
    },
    refetchInterval: 30_000,
  });

  const qualityQuery = useQuery<ChunkQuality>({
    queryKey: ["chunk-quality"],
    queryFn: async () => {
      const res = await fetch("/api/monitoring/chunk-quality");
      if (!res.ok) throw new Error("Failed to fetch chunk quality");
      const json = await res.json();
      return json.data ?? json;
    },
    refetchInterval: 60_000,
  });

  const pipelineQuery = useQuery<PipelineHealth>({
    queryKey: ["pipeline-health"],
    queryFn: async () => {
      const res = await fetch("/api/monitoring/pipeline-health");
      if (!res.ok) throw new Error("Failed to fetch pipeline health");
      const json = await res.json();
      return json.data ?? json;
    },
    refetchInterval: 30_000,
  });

  const trendsQuery = useQuery<
    {
      report_date: string;
      health_score: number;
      embedding_coverage_pct: number;
      hallucination_rate: number;
      guardrail_pass_rate: number;
    }[]
  >({
    queryKey: ["quality-trends"],
    queryFn: async () => {
      const res = await fetch("/api/monitoring/quality-trends");
      if (!res.ok) throw new Error("Failed to fetch quality trends");
      const json = await res.json();
      return json.data?.snapshots ?? json.snapshots ?? [];
    },
    refetchInterval: 60_000,
  });

  const snapshotMutation = useMutation({
    mutationFn: async (report: CorpusStats) => {
      const res = await fetch("/api/monitoring/quality-snapshots", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ report }),
      });
      if (!res.ok) throw new Error("Failed to save snapshot");
      return res.json();
    },
    onSuccess: () => trendsQuery.refetch(),
  });

  const stats = corpusQuery.data;
  const quality = qualityQuery.data;
  const pipeline = pipelineQuery.data;
  const trends = trendsQuery.data ?? [];
  const isLoading = corpusQuery.isLoading || snapshotMutation.isPending;

  const totalSizeChunks = stats?.chunking.chunk_size_distribution
    ? stats.chunking.chunk_size_distribution.undersized +
      stats.chunking.chunk_size_distribution.small +
      stats.chunking.chunk_size_distribution.optimal +
      stats.chunking.chunk_size_distribution.large +
      stats.chunking.chunk_size_distribution.oversized
    : 0;

  return (
    <div className="mx-auto max-w-[1600px] space-y-6 p-4 md:p-6 lg:p-8">
      <PageHeader
        title={t("admin.corpus.title")}
        description={t("admin.corpus.desc")}
        breadcrumbs={[
          { label: t("breadcrumb.dashboard"), href: "/dashboard" },
          { label: "Admin", href: "/dashboard/admin" },
          { label: "Corpus & Embeddings" },
        ]}
      />

      {/* Tab Switcher: Command Center vs DB Stats vs File Steward vs Chunk Inspector vs Chunk Quality */}
      <Tabs value={activeTab} onValueChange={setActiveTab} className="w-full">
        <TabsList className="grid w-full grid-cols-5">
          <TabsTrigger value="command-center">Command Center</TabsTrigger>
          <TabsTrigger value="db-stats">DB Übersicht</TabsTrigger>
          <TabsTrigger value="chunk-inspector">Chunk-Inspector</TabsTrigger>
          <TabsTrigger value="chunk-quality">Chunk-Quality</TabsTrigger>
          <TabsTrigger value="file-steward">Datei-Steward</TabsTrigger>
        </TabsList>
        <TabsContent value="command-center" className="mt-4">
          <CorpusCommandCenter onSelectCorpus={(sourceId) => { setSelectedSource(sourceId); setActiveTab("chunk-inspector"); }} />
        </TabsContent>
        <TabsContent value="chunk-inspector" className="mt-4">
          <ChunkInspector initialSource={selectedSource ?? "all"} />
        </TabsContent>
        <TabsContent value="chunk-quality" className="mt-4">
          <ChunkQuality liveEmbedding onSelectSource={(sourceId) => { setSelectedSource(sourceId); setActiveTab("chunk-inspector"); }} />
        </TabsContent>
        <TabsContent value="db-stats" className="space-y-6 mt-4">

      {/* Header Bar */}
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-3">
          {stats && healthBadge(stats.health.status)}
          <span className="text-sm font-medium">
            Health Score: {stats?.health.score ?? "—"}/100
          </span>
          <span className="text-xs text-[color:var(--ds-text-subtle)]">
            · Auto-Refresh 30s ·{" "}
            {stats
              ? `Aktualisiert: ${new Date(stats.generated_at).toLocaleTimeString("de-AT")}`
              : "Lädt…"}
          </span>
        </div>
        <div className="flex items-center gap-2">
          {stats && (
            <>
              <Button variant="outline" size="sm" onClick={() => downloadReportCSV(stats)}>
                <Download className="mr-2 h-4 w-4" />
                CSV
              </Button>
              <Button
                variant="outline"
                size="sm"
                onClick={() => snapshotMutation.mutate(stats)}
                disabled={snapshotMutation.isPending}
              >
                <Save className="mr-2 h-4 w-4" />
                Snapshot
              </Button>
            </>
          )}
          <Button
            variant="outline"
            size="sm"
            onClick={() => {
              corpusQuery.refetch();
              qualityQuery.refetch();
              pipelineQuery.refetch();
              trendsQuery.refetch();
            }}
            disabled={isLoading}
          >
            <RefreshCw className={`mr-2 h-4 w-4 ${isLoading ? "animate-spin" : ""}`} />
            Aktualisieren
          </Button>
        </div>
      </div>

      {corpusQuery.isError && (
        <Card>
          <CardContent className="p-8 text-center">
            <AlertTriangle className="mx-auto mb-3 h-12 w-12 text-[color:var(--ds-danger-text)]" />
            <p className="text-sm font-medium text-[color:var(--ds-danger-text)]">
              Fehler beim Laden der Corpus-Statistiken
            </p>
            <p className="mt-1 text-xs text-[color:var(--ds-text-subtle)]">
              {corpusQuery.error instanceof Error
                ? corpusQuery.error.message
                : "Unbekannter Fehler"}
            </p>
          </CardContent>
        </Card>
      )}

      {isLoading && (
        <div className="grid grid-cols-2 gap-4 md:grid-cols-5">
          {[...Array(5)].map((_, i) => (
            <Card key={i}>
              <CardContent className="p-4">
                <div className="h-8 w-8 animate-pulse rounded bg-[color:var(--ds-surface-hover)]" />
                <div className="mt-2 h-6 w-20 animate-pulse rounded bg-[color:var(--ds-surface-hover)]" />
                <div className="mt-1 h-3 w-16 animate-pulse rounded bg-[color:var(--ds-surface-hover)]" />
              </CardContent>
            </Card>
          ))}
        </div>
      )}

      {stats && (
        <>
          {/* § 1: Summary Cards */}
          <div className="grid grid-cols-2 gap-4 md:grid-cols-5">
            <Card>
              <CardContent className="flex items-center gap-3 p-4">
                <FileText className="h-8 w-8 text-[color:var(--ds-info-text)]" />
                <div>
                  <p className="text-2xl font-bold">{formatNumber(stats.corpus.total_pages)}</p>
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">Seiten</p>
                </div>
              </CardContent>
            </Card>
            <Card>
              <CardContent className="flex items-center gap-3 p-4">
                <Box className="h-8 w-8 text-purple-500" />
                <div>
                  <p className="text-2xl font-bold">{formatNumber(stats.corpus.total_chunks)}</p>
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">Chunks</p>
                </div>
              </CardContent>
            </Card>
            <Card>
              <CardContent className="flex items-center gap-3 p-4">
                <Database className="h-8 w-8 text-[color:var(--ds-success-text)]" />
                <div>
                  <p className="text-2xl font-bold">
                    {stats.corpus.embedding_coverage_pct.toFixed(1)}%
                  </p>
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">Embed-Coverage</p>
                </div>
              </CardContent>
            </Card>
            <Card>
              <CardContent className="flex items-center gap-3 p-4">
                <AlertTriangle className="h-8 w-8 text-[color:var(--ds-warning-text)]" />
                <div>
                  <p className="text-2xl font-bold">{formatNumber(stats.corpus.stale_chunks)}</p>
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">Stale Chunks</p>
                </div>
              </CardContent>
            </Card>
            <Card>
              <CardContent className="flex items-center gap-3 p-4">
                <Layers className="h-8 w-8 text-cyan-500" />
                <div>
                  <p className="text-2xl font-bold">{formatNumber(stats.corpus.orphan_pages)}</p>
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">Orphan-Seiten</p>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* § 2: Embedding Coverage */}
          <Card>
            <CardContent className="p-5">
              <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                <Database className="h-4 w-4 text-[color:var(--ds-success-text)]" />
                Embedding Coverage
              </h3>

              {/* Coverage Progress Bar */}
              <div className="mb-4">
                <div className="mb-1 flex items-center justify-between text-xs">
                  <span className="text-[color:var(--ds-text-subtle)]">
                    {formatNumber(stats.corpus.embedded_chunks)} /{" "}
                    {formatNumber(stats.corpus.total_chunks)} embedded
                  </span>
                  <span className="font-medium">
                    {stats.corpus.embedding_coverage_pct.toFixed(1)}%
                  </span>
                </div>
                <div className="relative h-4 rounded-full bg-[color:var(--ds-surface-hover)]">
                  <div
                    className={`absolute top-0 left-0 h-full rounded-full transition-all ${
                      stats.corpus.embedding_coverage_pct >= 95
                        ? "bg-[color:var(--ds-success-solid)]"
                        : stats.corpus.embedding_coverage_pct >= 80
                          ? "bg-[color:var(--ds-warning-solid)]"
                          : "bg-[color:var(--ds-danger-solid)]"
                    }`}
                    style={{ width: `${Math.max(stats.corpus.embedding_coverage_pct, 1)}%` }}
                  />
                </div>
              </div>

              {/* Embedding Models */}
              <div className="space-y-2">
                <p className="text-xs font-medium text-[color:var(--ds-text-subtle)]">
                  Embedding-Modelle:
                </p>
                {Object.entries(stats.embedding.chunks_by_model).map(([model, count]) => (
                  <div
                    key={model}
                    className="flex items-center justify-between rounded-md border p-2"
                  >
                    <span className="font-mono text-xs">{model}</span>
                    <div className="flex items-center gap-2">
                      <span className="text-sm font-medium">{formatNumber(count)}</span>
                      <Badge className="text-xs">
                        {stats.corpus.total_chunks > 0
                          ? ((count / stats.corpus.total_chunks) * 100).toFixed(1)
                          : 0}
                        %
                      </Badge>
                    </div>
                  </div>
                ))}
              </div>

              {/* HNSW Index Status */}
              <div className="mt-4 flex items-center gap-2 rounded-md border p-2">
                {stats.hnsw_index_exists ? (
                  <CheckCircle2 className="h-4 w-4 text-[color:var(--ds-success-text)]" />
                ) : (
                  <AlertTriangle className="h-4 w-4 text-[color:var(--ds-warning-text)]" />
                )}
                <span className="text-xs">
                  HNSW Vector Index: {stats.hnsw_index_exists ? "Aktiv" : "Nicht gefunden"}
                </span>
              </div>
            </CardContent>
          </Card>

          {/* § 3: Chunking Stats */}
          <div className="grid gap-4 md:grid-cols-2">
            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <Layers className="h-4 w-4 text-purple-500" />
                  Chunker Versionen
                </h3>
                <div className="space-y-2">
                  {stats.chunking.chunker_versions.map((cv) => (
                    <div
                      key={cv.version}
                      className="flex items-center justify-between rounded-md border p-2"
                    >
                      <div className="flex items-center gap-2">
                        <Badge className="font-mono text-xs">v{cv.version}</Badge>
                        {cv.version !== "unknown" && parseInt(cv.version, 10) < 4 && (
                          <Badge className="bg-[color:var(--ds-warning-bg)] text-xs text-[color:var(--ds-warning-text)]">Veraltet</Badge>
                        )}
                      </div>
                      <span className="text-sm font-medium">{formatNumber(cv.count)} Seiten</span>
                    </div>
                  ))}
                  {stats.chunking.chunker_versions.length === 0 && (
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">
                      Keine Chunker-Versionen gefunden.
                    </p>
                  )}
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <FileText className="h-4 w-4 text-[color:var(--ds-info-text)]" />
                  Seiten-Typen
                </h3>
                <div className="space-y-2">
                  {stats.chunking.page_types.slice(0, 8).map((pt) => (
                    <div
                      key={pt.type}
                      className="flex items-center justify-between rounded-md border p-2"
                    >
                      <span className="font-mono text-xs">{pt.type}</span>
                      <span className="text-sm font-medium">{formatNumber(pt.count)}</span>
                    </div>
                  ))}
                  {stats.chunking.page_types.length === 0 && (
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">
                      Keine Seiten-Typen gefunden.
                    </p>
                  )}
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Chunk Size Distribution */}
          <Card>
            <CardContent className="p-5">
              <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                <Box className="h-4 w-4 text-cyan-500" />
                Chunk-Größen-Distribution
              </h3>
              <div className="space-y-2">
                <SizeBar
                  label="< 200 chars"
                  count={stats.chunking.chunk_size_distribution.undersized}
                  total={totalSizeChunks}
                  color="bg-[color:var(--ds-danger-solid)]"
                />
                <SizeBar
                  label="200–1000 chars"
                  count={stats.chunking.chunk_size_distribution.small}
                  total={totalSizeChunks}
                  color="bg-blue-400"
                />
                <SizeBar
                  label="1000–3000 chars"
                  count={stats.chunking.chunk_size_distribution.optimal}
                  total={totalSizeChunks}
                  color="bg-[color:var(--ds-success-solid)]"
                />
                <SizeBar
                  label="3000–6000 chars"
                  count={stats.chunking.chunk_size_distribution.large}
                  total={totalSizeChunks}
                  color="bg-[color:var(--ds-warning-solid)]"
                />
                <SizeBar
                  label="> 6000 chars"
                  count={stats.chunking.chunk_size_distribution.oversized}
                  total={totalSizeChunks}
                  color="bg-[color:var(--ds-danger-solid)]"
                />
              </div>
              <div className="mt-4 flex flex-wrap gap-4 text-xs text-[color:var(--ds-text-subtle)]">
                <span>Ø {formatNumber(stats.chunking.avg_chunk_chars)} chars</span>
                <span>Min: {formatNumber(stats.chunking.min_chunk_chars)} chars</span>
                <span>Max: {formatNumber(stats.chunking.max_chunk_chars)} chars</span>
                <span>Chunks/Seite: {stats.corpus.chunks_per_page.toFixed(1)}</span>
              </div>
            </CardContent>
          </Card>

          {/* § 4: Chunk-Quality Optimierung */}
          {quality && (
            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <Wrench className="h-4 w-4 text-[color:var(--ds-warning-text)]" />
                  Chunk-Quality Optimierung
                </h3>

                {/* Re-Chunk Recommendations */}
                {quality.rechunk_recommendations.length > 0 && (
                  <div className="mb-4 rounded-md border border-[color:var(--ds-warning-border)] bg-[color:var(--ds-warning-bg)] p-3 dark:border-[color:var(--ds-warning-border)] dark:bg-[color:var(--ds-warning-bg)]/30">
                    <div className="mb-2 flex items-center gap-2">
                      <AlertTriangle className="h-4 w-4 text-[color:var(--ds-warning-text)]" />
                      <span className="text-sm font-medium">
                        {formatNumber(quality.summary.total_rechunk_pages)} Seiten mit veralteter
                        Chunker-Version
                      </span>
                    </div>
                    <div className="space-y-2">
                      {quality.rechunk_recommendations.slice(0, 5).map((rec, i) => (
                        <div
                          key={`${rec.source}-${rec.version}-${i}`}
                          className="flex items-center justify-between rounded border bg-[color:var(--ds-surface)] p-2"
                        >
                          <div className="flex items-center gap-2">
                            {priorityBadge(rec.priority)}
                            <span className="font-mono text-xs">{rec.source}</span>
                            <Badge className="text-xs">v{rec.version}</Badge>
                          </div>
                          <div className="flex items-center gap-3">
                            <span className="text-xs text-[color:var(--ds-text-subtle)]">
                              {rec.recommendation}
                            </span>
                            <span className="text-sm font-medium">
                              {formatNumber(rec.page_count)} Seiten
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* Quality Metrics Grid */}
                <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
                  <div className="rounded-md border p-3">
                    <div className="flex items-center gap-2">
                      {quality.summary.total_oversized === 0 ? (
                        <CheckCircle2 className="h-4 w-4 text-[color:var(--ds-success-text)]" />
                      ) : (
                        <AlertTriangle className="h-4 w-4 text-[color:var(--ds-danger-text)]" />
                      )}
                      <span className="text-xs text-[color:var(--ds-text-subtle)]">
                        Oversized (&gt;6000c)
                      </span>
                    </div>
                    <p className="mt-1 text-lg font-bold">
                      {formatNumber(quality.summary.total_oversized)}
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <div className="flex items-center gap-2">
                      {quality.summary.total_undersized === 0 ? (
                        <CheckCircle2 className="h-4 w-4 text-[color:var(--ds-success-text)]" />
                      ) : (
                        <AlertTriangle className="h-4 w-4 text-[color:var(--ds-warning-text)]" />
                      )}
                      <span className="text-xs text-[color:var(--ds-text-subtle)]">
                        Undersized (&lt;50c)
                      </span>
                    </div>
                    <p className="mt-1 text-lg font-bold">
                      {formatNumber(quality.summary.total_undersized)}
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <div className="flex items-center gap-2">
                      <Target className="h-4 w-4 text-[color:var(--ds-info-text)]" />
                      <span className="text-xs text-[color:var(--ds-text-subtle)]">
                        Boundary Cohesion
                      </span>
                    </div>
                    <p className="mt-1 text-lg font-bold">
                      {quality.boundary_cohesion.cohesion_pct.toFixed(1)}%
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <div className="flex items-center gap-2">
                      <Wrench className="h-4 w-4 text-[color:var(--ds-warning-text)]" />
                      <span className="text-xs text-[color:var(--ds-text-subtle)]">
                        Re-Chunk Queue
                      </span>
                    </div>
                    <p className="mt-1 text-lg font-bold">
                      {formatNumber(quality.rechunk_queue.length)}
                    </p>
                  </div>
                </div>

                {/* Boundary Cohesion Samples */}
                {quality.boundary_cohesion.samples.length > 0 &&
                  quality.boundary_cohesion.mid_sentence > 0 && (
                    <div className="mt-4">
                      <p className="mb-2 text-xs font-medium text-[color:var(--ds-text-subtle)]">
                        Mid-Sentence Boundary Samples (
                        {formatNumber(quality.boundary_cohesion.mid_sentence)} chunks):
                      </p>
                      <div className="space-y-1">
                        {quality.boundary_cohesion.samples.slice(0, 5).map((s, i) => (
                          <div
                            key={i}
                            className="flex items-center gap-2 rounded border p-2 text-xs"
                          >
                            <span className="font-mono text-[color:var(--ds-text-subtle)]">
                              {s.slug}
                            </span>
                            <span className="text-[color:var(--ds-text-subtle)]">
                              …{s.ending_chars}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                {/* Oversized Samples */}
                {quality.oversized_samples.length > 0 && (
                  <div className="mt-4">
                    <p className="mb-2 text-xs font-medium text-[color:var(--ds-text-subtle)]">
                      Oversized Chunk Samples (Top 10):
                    </p>
                    <div className="space-y-1">
                      {quality.oversized_samples.slice(0, 5).map((s, i) => (
                        <div
                          key={i}
                          className="flex items-center justify-between rounded border p-2 text-xs"
                        >
                          <span className="font-mono text-[color:var(--ds-text-subtle)]">
                            {s.slug}
                          </span>
                          <Badge className="bg-[color:var(--ds-danger-bg)] text-xs text-[color:var(--ds-danger-text)]">
                            {formatNumber(s.char_length)} chars
                          </Badge>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>
          )}

          {/* § 5: Per-Source Breakdown */}
          <Card>
            <CardContent className="p-5">
              <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                <Database className="h-4 w-4 text-[color:var(--ds-info-text)]" />
                Per-Source Breakdown
              </h3>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b text-left text-xs text-[color:var(--ds-text-subtle)]">
                      <th className="pr-4 pb-2 font-medium">Source</th>
                      <th className="pr-4 pb-2 text-right font-medium">Seiten</th>
                      <th className="pr-4 pb-2 text-right font-medium">Chunks</th>
                      <th className="pr-4 pb-2 text-right font-medium">Embedded</th>
                      <th className="pr-4 pb-2 text-right font-medium">Stale</th>
                      <th className="pb-2 text-right font-medium">Coverage</th>
                    </tr>
                  </thead>
                  <tbody>
                    {stats.per_source.map((src) => (
                      <tr key={src.source} className="border-b last:border-0">
                        <td className="py-2 pr-4 font-mono text-xs">{src.source}</td>
                        <td className="py-2 pr-4 text-right">{formatNumber(src.pages)}</td>
                        <td className="py-2 pr-4 text-right">{formatNumber(src.chunks)}</td>
                        <td className="py-2 pr-4 text-right">{formatNumber(src.embedded)}</td>
                        <td className="py-2 pr-4 text-right">
                          {src.stale > 0 ? (
                            <span className="text-[color:var(--ds-warning-text)]">{formatNumber(src.stale)}</span>
                          ) : (
                            <span className="text-[color:var(--ds-success-text)]">0</span>
                          )}
                        </td>
                        <td className="py-2 text-right">
                          <div className="flex items-center justify-end gap-2">
                            <div className="relative h-2 w-20 rounded-full bg-[color:var(--ds-surface-hover)]">
                              <div
                                className={`absolute top-0 left-0 h-full rounded-full ${
                                  src.coverage_pct >= 95
                                    ? "bg-[color:var(--ds-success-solid)]"
                                    : src.coverage_pct >= 80
                                      ? "bg-[color:var(--ds-warning-solid)]"
                                      : "bg-[color:var(--ds-danger-solid)]"
                                }`}
                                style={{ width: `${Math.max(src.coverage_pct, 1)}%` }}
                              />
                            </div>
                            <span className="text-xs font-medium">
                              {src.coverage_pct.toFixed(1)}%
                            </span>
                          </div>
                        </td>
                      </tr>
                    ))}
                    {stats.per_source.length === 0 && (
                      <tr>
                        <td
                          colSpan={6}
                          className="py-4 text-center text-xs text-[color:var(--ds-text-subtle)]"
                        >
                          Keine Source-Daten verfügbar.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>

          {/* § 6: Search Telemetry + Amendments (side by side) */}
          <div className="grid gap-4 md:grid-cols-2">
            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <Search className="h-4 w-4 text-cyan-500" />
                  Search Telemetry (7 Tage)
                </h3>
                {stats.search_telemetry ? (
                  <div className="space-y-3">
                    <div className="grid grid-cols-2 gap-3">
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">Aufrufe</p>
                        <p className="text-lg font-bold">
                          {formatNumber(stats.search_telemetry.total_calls_7d)}
                        </p>
                      </div>
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">Cache-Hit-Rate</p>
                        <p className="text-lg font-bold">
                          {(stats.search_telemetry.cache_hit_rate_7d * 100).toFixed(1)}%
                        </p>
                      </div>
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">Ø Ergebnisse</p>
                        <p className="text-lg font-bold">
                          {stats.search_telemetry.avg_results_7d.toFixed(1)}
                        </p>
                      </div>
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">Ø Rank-1-Score</p>
                        <p className="text-lg font-bold">
                          {stats.search_telemetry.avg_rank1_score !== null
                            ? stats.search_telemetry.avg_rank1_score.toFixed(3)
                            : "—"}
                        </p>
                      </div>
                    </div>
                    {stats.search_telemetry.rank1_distribution && (
                      <div className="rounded-md border p-3">
                        <p className="mb-2 text-xs text-[color:var(--ds-text-subtle)]">
                          Rank-1 Verteilung
                        </p>
                        <div className="flex h-4 overflow-hidden rounded-full">
                          {Object.entries(stats.search_telemetry.rank1_distribution).map(
                            ([k, v]) =>
                              v > 0 ? (
                                <div
                                  key={k}
                                  className={`${
                                    k === "high"
                                      ? "bg-[color:var(--ds-success-solid)]"
                                      : k === "solid"
                                        ? "bg-cyan-500"
                                        : "bg-slate-400"
                                  }`}
                                  style={{
                                    width: `${
                                      (v /
                                        (stats.search_telemetry!.rank1_distribution!.lt_solid +
                                          stats.search_telemetry!.rank1_distribution!.solid +
                                          stats.search_telemetry!.rank1_distribution!.high)) *
                                      100
                                    }%`,
                                  }}
                                  title={`${k}: ${v}`}
                                />
                              ) : null
                          )}
                        </div>
                        <div className="mt-1 flex justify-between text-xs text-[color:var(--ds-text-subtle)]">
                          <span>
                            lt_solid:{" "}
                            {formatNumber(stats.search_telemetry.rank1_distribution.lt_solid)}
                          </span>
                          <span>
                            solid: {formatNumber(stats.search_telemetry.rank1_distribution.solid)}
                          </span>
                          <span>
                            high: {formatNumber(stats.search_telemetry.rank1_distribution.high)}
                          </span>
                        </div>
                      </div>
                    )}
                    {stats.search_telemetry.intent_distribution && (
                      <div className="rounded-md border p-3">
                        <p className="mb-2 text-xs text-[color:var(--ds-text-subtle)]">
                          Intent Verteilung
                        </p>
                        <div className="space-y-1">
                          {Object.entries(stats.search_telemetry.intent_distribution)
                            .sort((a, b) => b[1] - a[1])
                            .slice(0, 5)
                            .map(([intent, count]) => (
                              <div key={intent} className="flex items-center justify-between">
                                <span className="text-xs">{intent}</span>
                                <span className="text-xs text-[color:var(--ds-text-subtle)]">
                                  {formatNumber(count)}
                                </span>
                              </div>
                            ))}
                        </div>
                      </div>
                    )}
                  </div>
                ) : (
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">
                    Search-Telemetrie nicht verfügbar.
                  </p>
                )}
              </CardContent>
            </Card>

            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <Activity className="h-4 w-4 text-purple-500" />
                  Amendments & Snapshots
                </h3>
                {stats.amendments ? (
                  <div className="space-y-3">
                    <div className="grid grid-cols-2 gap-3">
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">
                          Novellen (30 Tage)
                        </p>
                        <p className="text-lg font-bold">
                          {formatNumber(stats.amendments.total_30d)}
                        </p>
                      </div>
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">Stale Outputs</p>
                        <p className="text-lg font-bold">
                          {stats.amendments.unresolved_stale_outputs > 0 ? (
                            <span className="text-[color:var(--ds-warning-text)]">
                              {formatNumber(stats.amendments.unresolved_stale_outputs)}
                            </span>
                          ) : (
                            "0"
                          )}
                        </p>
                      </div>
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">
                          Betroffene Gesetze
                        </p>
                        <p className="text-lg font-bold">
                          {formatNumber(stats.amendments.statutes_affected)}
                        </p>
                      </div>
                      <div className="rounded-md border p-3">
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">Änderungen</p>
                        <p className="text-lg font-bold">
                          +{stats.amendments.by_change_type.added} / ~
                          {stats.amendments.by_change_type.modified} / -
                          {stats.amendments.by_change_type.removed}
                        </p>
                      </div>
                    </div>
                    {Object.keys(stats.amendments.by_jurisdiction).length > 0 && (
                      <div className="rounded-md border p-3">
                        <p className="mb-2 text-xs text-[color:var(--ds-text-subtle)]">
                          Nach Jurisdiktion
                        </p>
                        <div className="space-y-1">
                          {Object.entries(stats.amendments.by_jurisdiction)
                            .sort((a, b) => b[1] - a[1])
                            .map(([jur, count]) => (
                              <div key={jur} className="flex items-center justify-between">
                                <span className="font-mono text-xs">{jur}</span>
                                <span className="text-xs text-[color:var(--ds-text-subtle)]">
                                  {formatNumber(count)}
                                </span>
                              </div>
                            ))}
                        </div>
                      </div>
                    )}
                  </div>
                ) : (
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">
                    Amendment-Tracking nicht verfügbar.
                  </p>
                )}
                {stats.snapshots && (
                  <div className="mt-3 rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Snapshots</p>
                    <div className="mt-1 flex items-center gap-2">
                      <span className="text-sm font-medium">{stats.snapshots.current} current</span>
                      <span className="text-xs text-[color:var(--ds-text-subtle)]">
                        · {stats.snapshots.jurisdictions.join(", ") || "keine"}
                      </span>
                    </div>
                    {stats.snapshots.newest && (
                      <p className="mt-1 text-xs text-[color:var(--ds-text-subtle)]">
                        Neueste: {stats.snapshots.newest.slice(0, 10)}
                      </p>
                    )}
                  </div>
                )}
              </CardContent>
            </Card>
          </div>

          {/* § 7: Hallucination & Quality Guardrails */}
          {stats.hallucination && (
            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <ShieldCheck className="h-4 w-4 text-[color:var(--ds-info-text)]" />
                  Quality Guardrails (7 Tage)
                </h3>
                <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Traces</p>
                    <p className="text-lg font-bold">
                      {formatNumber(stats.hallucination.total_traces)}
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Hallucination Rate</p>
                    <p
                      className={`text-lg font-bold ${stats.hallucination.hallucination_rate > 15 ? "text-[color:var(--ds-danger-text)]" : stats.hallucination.hallucination_rate > 5 ? "text-[color:var(--ds-warning-text)]" : "text-[color:var(--ds-success-text)]"}`}
                    >
                      {stats.hallucination.hallucination_rate.toFixed(1)}%
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Guardrail Pass</p>
                    <p className="text-lg font-bold">
                      {stats.hallucination.guardrail_pass_rate.toFixed(1)}%
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Provenance</p>
                    <p className="text-lg font-bold">
                      {stats.hallucination.provenance_coverage.toFixed(1)}%
                    </p>
                  </div>
                </div>
                <div className="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Cross-Verify Clean</p>
                    <p className="text-lg font-bold">
                      {stats.hallucination.cross_verify_clean_rate.toFixed(1)}%
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Regeneration</p>
                    <p className="text-lg font-bold">
                      {stats.hallucination.regeneration_rate.toFixed(1)}%
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Ø Confidence</p>
                    <p className="text-lg font-bold">
                      {stats.hallucination.avg_confidence !== null
                        ? stats.hallucination.avg_confidence.toFixed(3)
                        : "—"}
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Low Confidence</p>
                    <p className="text-lg font-bold">
                      {stats.hallucination.low_confidence_rate.toFixed(1)}%
                    </p>
                  </div>
                </div>
              </CardContent>
            </Card>
          )}

          {/* § 8: Pipeline Health */}
          {pipeline && (
            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <Activity className="h-4 w-4 text-cyan-500" />
                  Pipeline Health
                  <span className="ml-2">{healthBadge(pipeline.status)}</span>
                </h3>
                <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Engine Status</p>
                    <p className="text-lg font-bold">{pipeline.engine.status}</p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">Pending Embeddings</p>
                    <p className="text-lg font-bold">{formatNumber(pipeline.pending_embeddings)}</p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">DB Locks</p>
                    <p className="text-lg font-bold">
                      {formatNumber(pipeline.db.waiting_on_locks)}
                    </p>
                  </div>
                  <div className="rounded-md border p-3">
                    <p className="text-xs text-[color:var(--ds-text-subtle)]">HNSW Index</p>
                    <p className="text-lg font-bold">
                      {pipeline.hnsw_index_exists ? "Aktiv" : "Fehlt"}
                    </p>
                  </div>
                </div>
                {pipeline.engine.jobs && (
                  <div className="mt-3 grid grid-cols-3 gap-3">
                    <div className="rounded-md border p-3">
                      <p className="text-xs text-[color:var(--ds-text-subtle)]">Jobs Pending</p>
                      <p className="text-lg font-bold">
                        {formatNumber(pipeline.engine.jobs.pending)}
                      </p>
                    </div>
                    <div className="rounded-md border p-3">
                      <p className="text-xs text-[color:var(--ds-text-subtle)]">Jobs Active</p>
                      <p className="text-lg font-bold">
                        {formatNumber(pipeline.engine.jobs.active)}
                      </p>
                    </div>
                    <div className="rounded-md border p-3">
                      <p className="text-xs text-[color:var(--ds-text-subtle)]">Failed 1h</p>
                      <p className="text-lg font-bold">
                        {formatNumber(pipeline.engine.jobs.failed_1h)}
                      </p>
                    </div>
                  </div>
                )}
                <div className="mt-4 space-y-2">
                  {pipeline.checks.map((check, i) => (
                    <div
                      key={`${check.name}-${i}`}
                      className="flex items-center justify-between rounded-md border p-3"
                    >
                      <div className="flex items-center gap-3">
                        {checkIcon(check.status)}
                        <div>
                          <p className="font-mono text-xs font-medium">{check.name}</p>
                          <p className="text-xs text-[color:var(--ds-text-subtle)]">
                            {check.message}
                          </p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          )}

          {/* § 9: Quality Trends */}
          {trends.length > 0 && (
            <Card>
              <CardContent className="p-5">
                <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                  <Activity className="h-4 w-4 text-pink-500" />
                  Quality Trends (letzte {trends.length} Tage)
                </h3>

                {/* Coverage & Health Score — Area Chart */}
                <div className="mb-6">
                  <p className="mb-2 text-xs font-medium text-[color:var(--ds-text-subtle)]">
                    Health Score & Embedding Coverage
                  </p>
                  <ResponsiveContainer width="100%" height={200}>
                    <AreaChart data={trends}>
                      <defs>
                        <linearGradient id="gradHealth" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stopColor="var(--brand-primary)" stopOpacity={0.3} />
                          <stop offset="100%" stopColor="var(--brand-primary)" stopOpacity={0} />
                        </linearGradient>
                        <linearGradient id="gradCoverage" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stopColor="var(--signal-success-500)" stopOpacity={0.3} />
                          <stop offset="100%" stopColor="var(--signal-success-500)" stopOpacity={0} />
                        </linearGradient>
                      </defs>
                      <CartesianGrid strokeDasharray="3 3" stroke="var(--ds-border)" className="opacity-30" />
                      <XAxis
                        dataKey="report_date"
                        tickFormatter={(v: string) => v.slice(5)}
                        fontSize={11}
                        className="text-[color:var(--ds-text-subtle)]"
                      />
                      <YAxis domain={[0, 100]} fontSize={11} />
                      <Tooltip
                        contentStyle={{ background: "var(--ds-surface)", border: "1px solid var(--ds-border)", borderRadius: 6, color: "var(--ds-text)", fontSize: 12 }}
                        labelStyle={{ color: "var(--ds-text)", fontWeight: 600 }}
                        labelFormatter={(v: string) => `Datum: ${v}`}
                        formatter={(value: number) => [Number(value).toFixed(1), ""]}
                      />
                      <Legend />
                      <Area
                        type="monotone"
                        dataKey="health_score"
                        stroke="var(--brand-primary)"
                        fill="url(#gradHealth)"
                        name="Health Score"
                        strokeWidth={2}
                      />
                      <Area
                        type="monotone"
                        dataKey="embedding_coverage_pct"
                        stroke="var(--signal-success-500)"
                        fill="url(#gradCoverage)"
                        name="Coverage %"
                        strokeWidth={2}
                      />
                    </AreaChart>
                  </ResponsiveContainer>
                </div>

                {/* Guardrail & Hallucination — Line Chart */}
                <div>
                  <p className="mb-2 text-xs font-medium text-[color:var(--ds-text-subtle)]">
                    Guardrail Pass & Hallucination Rate
                  </p>
                  <ResponsiveContainer width="100%" height={200}>
                    <LineChart data={trends}>
                      <CartesianGrid strokeDasharray="3 3" stroke="var(--ds-border)" className="opacity-30" />
                      <XAxis
                        dataKey="report_date"
                        tickFormatter={(v: string) => v.slice(5)}
                        fontSize={11}
                        className="text-[color:var(--ds-text-subtle)]"
                      />
                      <YAxis domain={[0, 100]} fontSize={11} />
                      <Tooltip
                        contentStyle={{ background: "var(--ds-surface)", border: "1px solid var(--ds-border)", borderRadius: 6, color: "var(--ds-text)", fontSize: 12 }}
                        labelStyle={{ color: "var(--ds-text)", fontWeight: 600 }}
                        labelFormatter={(v: string) => `Datum: ${v}`}
                        formatter={(value: number) => [Number(value).toFixed(1) + "%", ""]}
                      />
                      <Legend />
                      <Line
                        type="monotone"
                        dataKey="guardrail_pass_rate"
                        stroke="var(--accent-premium)"
                        name="Guardrail Pass %"
                        strokeWidth={2}
                        dot={{ r: 3 }}
                      />
                      <Line
                        type="monotone"
                        dataKey="hallucination_rate"
                        stroke="var(--signal-danger-500)"
                        name="Hallucination %"
                        strokeWidth={2}
                        dot={{ r: 3 }}
                      />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              </CardContent>
            </Card>
          )}

          {/* § 10: Health Checks */}
          <Card>
            <CardContent className="p-5">
              <h3 className="mb-4 flex items-center gap-2 text-sm font-semibold">
                <Zap className="h-4 w-4 text-[color:var(--ds-warning-text)]" />
                Health Checks
              </h3>
              <div className="space-y-2">
                {stats.health.checks.map((check, i) => (
                  <div
                    key={`${check.name}-${i}`}
                    className="flex items-center justify-between rounded-md border p-3"
                  >
                    <div className="flex items-center gap-3">
                      {checkIcon(check.status)}
                      <div>
                        <p className="font-mono text-xs font-medium">{check.name}</p>
                        <p className="text-xs text-[color:var(--ds-text-subtle)]">
                          {check.message}
                        </p>
                      </div>
                    </div>
                    {check.threshold !== undefined && (
                      <div className="text-right text-xs">
                        <span className="font-mono">
                          {check.value !== undefined ? formatNumber(check.value) : "—"}
                        </span>
                        <span className="text-[color:var(--ds-text-subtle)]">
                          {" "}
                          / {formatNumber(check.threshold)}
                        </span>
                      </div>
                    )}
                  </div>
                ))}
                {stats.health.checks.length === 0 && (
                  <p className="text-xs text-[color:var(--ds-text-subtle)]">
                    Keine Health-Checks verfügbar.
                  </p>
                )}
              </div>
            </CardContent>
          </Card>
        </>
      )}

      {/* Empty State */}
      {!stats && !isLoading && !corpusQuery.isError && (
        <Card>
          <CardContent className="p-8 text-center">
            <Database className="mx-auto mb-3 h-12 w-12 text-[color:var(--ds-text-subtle)]" />
            <p className="text-sm text-[color:var(--ds-text-subtle)]">
              Keine Corpus-Daten verfügbar. Datenbank nicht verbunden.
            </p>
          </CardContent>
        </Card>
      )}
        </TabsContent>
        <TabsContent value="file-steward" className="mt-4">
          <CorpusStewardTab />
        </TabsContent>
      </Tabs>
    </div>
  );
}
