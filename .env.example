# ── Subsumio Web-App (Next.js) — Produktions-Env ──────────────────────────
# Kopiere nach .env.local (Dev) bzw. setze im Docker-Compose .env (Netcup).

# ── SEO / Domains (PFLICHT für korrektes SEO) ───────────────────────────────
# Kanonische Basis-URL der Plattform. Steuert canonical-Tags, OG-URLs und die
# Sitemap. MUSS auf die echte Domain zeigen — sonst verweisen alle SEO-Signale
# auf eine tote/geparkte Domain.
NEXT_PUBLIC_SITE_URL=https://subsum.io
# Kanonische öffentliche URL des Subsumio-Produkts. Default "/subsumio" (interne
# Route). Auf "https://subsum.io" setzen, sobald die Domain am Server
# hängt — dann verlinkt der Plattform-Hub nach außen und der Canonical der
# Subsumio-Seiten konsolidiert auf subsum.io.
NEXT_PUBLIC_SUBSUMIO_URL=/subsumio
# Hosts, die auf die Subsumio-Marke routen (Komma-getrennt). Default:
# subsum.io,www.subsum.io,subsum.io,www.subsum.io
NEXT_PUBLIC_SUBSUMIO_HOSTS=

# Betreiber-Konsole (/ops, nur Subsumio-Team). Kommagetrennte E-Mails; die
# Konten brauchen zusätzlich aktive 2FA. Leer = niemand (fail-closed).
PLATFORM_OPERATOR_EMAILS=
# Hosts, auf denen /ops und die Betreiber-APIs ausgeliefert werden.
# Default Produktion: ops.subsum.io; lokal zusätzlich ops.localhost:3000.
OPS_HOSTS=

# Engine-Anbindung (PFLICHT in Produktion — sonst antworten alle Proxies 503).
# URL des subsumio-Servers (gestartet mit: subsumio serve --http --port 3001).
# SUBSUMIO_* ist der primäre Prefix.
SUBSUMIO_API_URL=

# Upload-Limits auf Agenturniveau. Default 1 GB pro Dokument / 200 MB pro Bild.
# Große Uploads werden client-seitig gestaffelt (max 2 große gleichzeitig).
# Der Engine-Prozess MUSS GBRAIN_MAX_UPLOAD_BYTES >= MAX_UPLOAD_BYTES setzen.
# MAX_UPLOAD_BYTES=1073741824
# MAX_IMAGE_BYTES=209715200
# Original-Dateien werden zusätzlich zum extrahierten Text gespeichert (Download/GoBD).
# Default: lokales Volume unter ${GBRAIN_HOME}/files (/data sichern!). Für S3/MinIO
# den storage:-Block in der Engine-Config setzen — siehe docs/DEPLOY_ENGINE.md.

# Shared Secret zwischen Web-App und Engine. MUSS auf BEIDEN Seiten gesetzt
# sein: hier UND als SUBSUMIO_WEB_API_KEY beim Engine-Prozess.
# Ohne Key akzeptiert die Engine jeden Aufrufer!
SUBSUMIO_WEB_API_KEY=

# Internes Service-zu-Service Secret (z.B. Upload → Auto-Analyse).
# Generieren: openssl rand -hex 32
# Ohne diesen Wert wird die Auto-Analyse nach Upload nicht getriggert.
SUBSUMIO_INTERNAL_SECRET=

# Session-Signatur (HMAC). 32+ zufällige Bytes, z. B.: openssl rand -hex 32
AUTH_SECRET=

# Auth-/Usage-Store: Postgres-URL (PFLICHT in Produktion; Dev nutzt .data/).
# Eine der vier Varianten wird erkannt:
SUBSUMIO_AUTH_DATABASE_URL=
# DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=

# Stripe (Billing) — ohne diese Werte zeigt die UI den "nicht verbunden"-Zustand.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_KANZLEI=
# Credit Packs (one-time payments for AI credits)
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=

# Transaktionale E-Mails (Passwort-Reset, Verifikation, Fristen-Digest) via Resend.
# Ohne Key wird die Mail in die Server-Konsole gedruckt (Dev-Modus).
RESEND_API_KEY=
MAIL_FROM=Subsumio <hello@subsum.io>
MAIL_REPLY_TO=hello@subsum.io

# Web push for the client portal ("benachrichtigen, wenn die Kanzlei antwortet").
# Generate once: npx web-push generate-vapid-keys. Without keys the portal offers no notifications.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@subsum.io
# Eingehende E-Mails via Resend Receiving.
# Webhook-URL: https://deine-domain/api/email/webhook/resend
# Event: email.received
RESEND_WEBHOOK_SECRET=
# Optionaler Fallback-Brain für eingehende Mails ohne Plus-Adresse.
# Plus-Adressen wie hello+brain_abcd@subsum.io werden automatisch geroutet.
EMAIL_INBOUND_DEFAULT_BRAIN_ID=

# Fristen-Digest-Cron (/api/cron/deadlines, täglich 06:00 UTC via supercronic).
# Server: CRON_SECRET wird im cron-Container als Env gesetzt; supercronic
# sendet  curl -H "Authorization: Bearer $CRON_SECRET" …/api/cron/deadlines
CRON_SECRET=

# Daily Rundown agent (/api/cron/rundown, täglich 05:00 UTC via supercronic).
# Set to "true" to disable the Rundown cron (opt-out).
# Default: enabled. Budget cap: $0.30/brain/day.
DISABLE_RUNDOWN_CRON=

# Öffentliche App-URL (für Links in E-Mails).
NEXT_PUBLIC_APP_URL=

# WhatsApp Business Platform / Cloud API (interner Kanzlei-Assistent).
# Webhook-URL in Meta: https://deine-domain/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: Graph API Version und Medienannahme. Meta-Media-URLs sind nur kurz gültig;
# Kanzlei OS lädt deshalb sofort herunter und speichert Hash + Pfad im Brain.
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_MEDIA_STORAGE_PROVIDER=local
WHATSAPP_MEDIA_STORAGE_DIR=.data/whatsapp-media
WHATSAPP_MEDIA_MAX_BYTES=26214400
# Erlaubte Anwalt-Nummern und Brain-Zuordnung. Nur diese Sender dürfen schreiben.
# Beispiel:
# WHATSAPP_ALLOWED_SENDERS_JSON=[{"phone":"+491701234567","brainId":"brain_abc123","userId":"user_1","name":"RA Mustermann","role":"lawyer"}]
WHATSAPP_ALLOWED_SENDERS_JSON=
# Dev-Fallback, wenn kein JSON gesetzt ist (NUR dev — in Produktion ignoriert, kein env-Fallback):
# WHATSAPP_ALLOWED_PHONE=
# WHATSAPP_DEFAULT_BRAIN_ID=
# WHATSAPP_DEFAULT_USER_NAME=

# Proaktiver KI-Sekretär — Tagesbriefing (Paket 33, P1-SECR-004)
# Genehmigtes Meta-Template für das Briefing außerhalb des 24h-Fensters.
# Ohne dieses Template wird ein außerhalb des Fensters fälliges Briefing geblockt (und auditiert).
# WHATSAPP_BRIEFING_TEMPLATE=daily_briefing
# Quiet Hours (lokale Stunden, Format "START-ENDE", darf Mitternacht überspannen): kein nicht-dringender Versand.
# WHATSAPP_BRIEFING_QUIET_HOURS=21-7

# WhatsApp Voice Message Transcription (via OpenRouter)
# Sprachnachrichten werden über die Engine transkribiert (/api/llm/transcribe); die Web-App braucht dafür keinen Provider-Key.
# WHATSAPP_TRANSCRIPTION_MODEL=whisper-1
# WHATSAPP_TRANSCRIPTION_LANGUAGE=de

# WhatsApp Flows (structured forms: case intake, appointment booking)
# RSA private key (PEM format) for decrypting Flow data exchange requests.
# Generate with: openssl genrsa -out flow_private.pem 2048
# Register the public key with Meta when creating a Flow via Flows API.
# WHATSAPP_FLOW_PRIVATE_KEY_PEM=

# SMS via Twilio (WP-8.53) — Consent-gated wie WhatsApp, eigener Consent-Kanal.
# Ohne diese Werte meldet /api/sms/send ehrlich sms_not_configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Entweder eine Twilio-Rufnummer ODER einen Messaging Service verwenden.
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# Video-Termine via Jitsi (WP-8.53) — Raumname ist HMAC des Termin-Slugs,
# enthält keine Mandantendaten. Eigene Jitsi-Instanz oder meet.jit.si.
JITSI_DOMAIN=

# ── Encryption & Data (PFLICHT in Produktion) ─────────────────────────────
# AES-256-GCM Key für Verschlüsselung sensibler Felder (API keys, 2FA secrets).
# Generieren: openssl rand -hex 32
SUBSUMIO_ENCRYPTION_KEY=

# File-based Storage (Dev/Self-hosted). Default: .data/ im Projektverzeichnis.
SUBSUMIO_DATA_DIR=

# Demo Brain Slug für öffentliche Demo (niemals ein Tenant-Brain!).
SUBSUMIO_DEMO_BRAIN=demo

# Optional: verteilter Rate-Limiter (Brute-Force-Schutz instanzübergreifend).
# Ohne diese Werte: in-memory pro Instanz (für Single-Instanz ausreichend).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoring & Analytics (optional) ───────────────────────────────────────
# Sentry DSN für Error-Tracking und Performance-Monitoring.
# Erstelle ein Projekt auf https://sentry.io und kopiere den DSN.
NEXT_PUBLIC_SENTRY_DSN=

# PostHog für Product Analytics.
# Erstelle ein Projekt auf https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── SCIM Directory Sync (WorkOS) ────────────────────────────────────────────
# Org-scoped Bearer Tokens für inbound SCIM 2.0 Requests, ein Token pro Mandant.
# Format: "orgId1:token1,orgId2:token2". Jede IdP-Verbindung bekommt ihr
# eigenes Token; Requests werden strikt auf den zugehörigen orgId beschränkt
# (kein Mandant kann Daten eines anderen Mandanten über SCIM sehen/ändern).
# Generieren je Token: openssl rand -hex 32
SCIM_BEARER_TOKENS=
# Legacy/Single-Tenant-Fallback: nur aktiv, wenn SCIM_SINGLE_TENANT_ORG_ID
# ebenfalls gesetzt ist (sonst wird das Token ignoriert — fail-closed).
SCIM_BEARER_TOKEN=
SCIM_SINGLE_TENANT_ORG_ID=
# WorkOS Directory Sync: jede Kanzlei hat ihr eigenes Verzeichnis
# (Org.workosDirectoryId, vom Betreiber gesetzt). Single-Tenant-Fallback:
# WORKOS_DIRECTORY_ID gilt NUR für die Kanzlei WORKOS_DIRECTORY_ORG_ID —
# ohne diese Angabe wird es ignoriert (fail-closed).
WORKOS_DIRECTORY_ID=
WORKOS_DIRECTORY_ORG_ID=
# Optional: Token-Preview für die SCIM-Einstellungsseite (nur Anzeige, nicht sicherheitsrelevant).
# NEXT_PUBLIC_SCIM_TOKEN_PREVIEW=

# ── beA Middleware (partner_adapter) ───────────────────────────────────────
# Zertifizierter Middleware-Anbieter für beA-Versand (XJustiz-Protokoll).
# Wenn nicht gesetzt, wird XJustiz-XML zum manuellen Upload generiert.
# BEA_MIDDLEWARE_URL=https://middleware-provider.example.com
# BEA_MIDDLEWARE_API_KEY=
# BEA_SENDER_ID=RA-12345-67890

# ── Microsoft 365 Graph API (Outlook/Calendar Sync) ───────────────────────
# Client credentials flow for Microsoft Graph API (Outlook calendar, mail).
# Required for Outlook calendar sync and event creation.
# MS365_CLIENT_ID=
# MS365_CLIENT_SECRET=
# MS365_TENANT_ID=
# MS365_MAILBOX=          # service mailbox (UPN) the app credentials act on; required
# MS365_CALENDAR_NAME=calendar
# MS365_OUTLOOK_FOLDER=Inbox

# ── EU-Datenmodus (Web-App) ─────────────────────────────────────────────────
# SUBSUMIO_EU_MODEL_ROUTE=1      # Betreiber bestätigt: in der Engine ist ein
#                                # EU-Modellweg eingerichtet (z. B. bedrock:eu.*,
#                                # mistral:*). Dann starten neue Kanzleien aus
#                                # AT/DE/CH im EU-Datenmodus (modelPolicy eu_only)
#                                # und Admins können ihn einschalten. Ohne diese
#                                # Bestätigung bleibt „alle Anbieter“ und die
#                                # KI-Einstellungen zeigen, dass Anfragen an
#                                # Anbieter in den USA gehen.

# ── Engine-Prozess (subsumio serve --http) — separates Env ────────────────
# SUBSUMIO_WEB_API_KEY=           # identisch mit SUBSUMIO_WEB_API_KEY oben
# SUBSUMIO_REQUIRE_TENANT=true    # PFLICHT für Multi-Tenant/SaaS: lehnt jeden
#                                # Request ohne gültigen Tenant-Header mit 400
#                                # ab (fail-closed; 'default' nie erreichbar).
# SUBSUMIO_DATABASE_URL=          # Postgres+pgvector der Engine
# Provider-Keys gehören NUR in die Engine (server/.env). Die Web-App ruft Modelle
# ausschließlich über die Engine auf (/api/think, /api/llm/complete, /api/llm/transcribe).
# COPILOT_MEMORY_LLM_MODEL=openrouter:deepseek/deepseek-chat  # Modell für LLM-basierte Memory-Extraction (P0.1)
# GBRAIN_EMBEDDING_IMAGE_OCR=true # OCR für gescannte Dokumente/Bilder (P0-4)
#                                # Standardmäßig AKTIV (Agentur-Qualität).
#                                # Setzen Sie auf false, um OCR zu deaktivieren.
#                                # Benötigt graphicsmagick+ghostscript (im Docker-Image enthalten).
# GBRAIN_OCR_MAX_PAGES=100        # Max. Seiten, die pro gescanntem PDF synchron
#                                # OCR-verarbeitet werden (Timeout-/Kostenschutz).
#                                # 0/negativ = kein Limit.
# GBRAIN_OCR_DAILY_PAGES_PER_FIRM=2000  # OCR-Seiten pro Kanzlei und Tag (Kostenschutz);
#                                # darüber: Dokument "teilweise gelesen", OCR offen.
#                                # 0 = kein Limit.
#
# WICHTIG: Agenten-Jobs (Supervisor/Subagents aus dem Dashboard) braucht
# einen Minion-Worker. Zwei Optionen:
#   subsumio serve --http --with-worker   # Worker im selben Prozess
#                                       # (PFLICHT bei PGLite, ok für kleine
#                                       # Postgres-Deployments)
#   subsumio jobs work                    # dedizierter Worker-Prozess
#                                       # (empfohlen für größere Deployments)
# Ohne Worker bleiben Dashboard-Agenten dauerhaft im Status "queued".

# ── Logging ─────────────────────────────────────────────────────────────────
# Strukturiertes JSON-Logging (debug | info | warn | error). Default: info.
# LOG_LEVEL=info

# ── IP Allow-Listing (G8: Enterprise Security) ──────────────────────────────
# Komma-getrennte IPs/CIDRs, die auf Dashboard/API/Admin zugreifen dürfen.
# Ohne Wert: alle IPs erlaubt (Default). Health-Endpoints sind immer erlaubt.
# SUBSUMIO_IP_ALLOWLIST=10.0.0.0/8,192.168.1.100

# ── App-Hosts (Multi-Domain Routing) ────────────────────────────────────────
# Komma-getrennte Hosts, die auf die Subsumio-App (Dashboard) routen.
# Default: app.subsum.io,cockpit.subsum.io
# SUBSUMIO_APP_HOSTS=app.subsum.io,cockpit.subsum.io

# ── Öffentliche App-URL (für interne Links) ─────────────────────────────────
# SUBSUMIO_APP_URL=https://app.subsum.io

# ── Redis (Presence/Realtime) ───────────────────────────────────────────────
# Optional: für Multi-Instanz Presence (Co-Editing). Ohne Wert: in-memory.
# REDIS_URL=redis://localhost:6379

# ── DocuSign Integration ────────────────────────────────────────────────────
# Für elektronische Unterschriften. Alle Werte aus dem DocuSign Admin.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_SECRET_KEY=
# DOCUSIGN_ACCOUNT_ID=
# REST-Basis inkl. Konto-Server. Demo: https://demo.docusign.net/restapi/v2.1,
# Produktion z. B. https://eu.docusign.net/restapi/v2.1 (Wert aus dem DocuSign-Konto).
# Mit NODE_ENV=production Pflicht; die Demo-Umgebung wird dort abgelehnt (DocuSign gilt
# dann als nicht eingerichtet).
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi/v2.1
# Anmelde-Host; wird aus DOCUSIGN_BASE_URL abgeleitet (demo → account-d.docusign.com,
# sonst account.docusign.com). Nur setzen, wenn abweichend.
# DOCUSIGN_OAUTH_HOST=
# DOCUSIGN_PRIVATE_KEY=  # RSA private key PEM, base64-kodiert (für JWT-Auth)
# DOCUSIGN_CONNECT_SECRET=  # HMAC-Secret der Connect-Konfiguration
# Connect: URL {NEXT_PUBLIC_APP_URL}/api/docusign/webhook, HMAC aktiv,
# "Include Custom Fields" aktiv (liefert brain_id und case_slug zurück).

# ── Backup (Pflicht vor dem Echtbetrieb) ───────────────────────────────────
# Gesichert wird alles, was eine Kanzlei verlieren würde: Datenbank ohne den
# öffentlichen Rechtskorpus (der ist aus RIS wiederherstellbar) plus Originale.
# Offsite (empfohlen): restic-Repository auf S3-kompatiblem Objektspeicher.
# BACKUP_RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/subsumio-backup
# BACKUP_RESTIC_PASSWORD=       # langes Passwort, GETRENNT vom Server aufbewahren
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Lokale verschlüsselte Kopie (läuft auch ohne Offsite-Ziel; ersetzt es nicht).
# BACKUP_LOCAL_DIR=/backups
# BACKUP_LOCAL_PASSPHRASE=      # ohne dieses Passwort kein lokales Backup
# BACKUP_LOCAL_KEEP_DAYS=14
# Warnung per E-Mail, wenn ein Backup-Lauf scheitert:
# QUEUE_ALERT_EMAIL=kanzlei@example.at

# ── Qualifizierte Signatur (PDF-AS-WEB: ID Austria, A-Trust-Signaturkarte) ──
# Adresse einer PDF-AS-WEB-Instanz (EGIZ/A-SIT, eigener Betrieb oder Dienstleister).
# Ohne Wert ist „Qualifiziert signieren“ ausgeblendet.
# PDFAS_WEB_URL=https://pdfas.example.at/pdf-as-web
# In PDF-AS-WEB freigeben (Whitelist): {NEXT_PUBLIC_APP_URL}/api/signature/qes/*
# PDF-AS-WEB holt das Original über {NEXT_PUBLIC_APP_URL}/api/signature/qes/pdf/<token>;
# eine IP-Sperre davor muss die PDF-AS-Instanz durchlassen.

# ── RCIID Krypto-Forensik Integration ───────────────────────────────────────
# Verbindung zur rciid.at Forensik-Plattform für Krypto-Wallet-Untersuchungen.
# RCIID_API_URL=https://rciid.at/api/v1
# RCIID_API_KEY=
# RCIID_WEBHOOK_SECRET=  # HMAC-SHA256 Secret für Webhook-Signatur-Verifikation

# ── DMS Integration (Dokumentenmanagement) ──────────────────────────────────
# Anbindung an externes DMS (z.B. d.velop, ELO, Sharepoint).
# DMS_PROVIDER=  # imanager | netdocuments | sharepoint | box | none
# DMS_ALLOWED_BRAIN_IDS=  # Pflicht: Brain-IDs der Kanzlei(en), denen dieses DMS gehört (kommagetrennt); leer = keine Kanzlei
# DMS_BASE_URL=
# DMS_API_KEY=
# SHAREPOINT_SITE_ID=   # optional, auto-discovered if not set
# SHAREPOINT_DRIVE_ID=  # optional, auto-discovered if not set
# BOX_FOLDER_ID=        # optional, defaults to "0" (root)
# BOX_ENTERPRISE_ID=    # optional, for JWT auth

# ── Microsoft 365 / Graph API (Outlook, Calendar, Contacts) ────────────────
# MS365_CLIENT_ID=      # Azure AD App Registration Client ID
# MS365_CLIENT_SECRET=  # Azure AD App Registration Client Secret
# MS365_TENANT_ID=      # Azure AD Tenant ID
# MS365_OUTLOOK_FOLDER= # optional, default: Inbox
# MS365_CALENDAR_NAME=  # optional, default: calendar

# ── ClamAV (Virus-Scan für Uploads) ─────────────────────────────────────────
# Optional: ClamAV-Server für Viren-Scan hochgeladener Dateien.
# Ohne Wert: kein Viren-Scan (Dev-Modus).
# CLAMAV_HOST=  # z.B. localhost:3310

# ── Perplexity API (KI-Recherche) ───────────────────────────────────────────
# Für Perplexity-basierte Rechtsprechungs-Recherche im Research-Tab.
# PERPLEXITY_API_KEY=

# ── Portal (Mandanten-Portal) ───────────────────────────────────────────────
# Secret für Mandanten-Portal-Token-Signierung. In Produktion Pflicht — der
# Start bricht ohne ab (src/lib/env-validate.ts).
# Generieren: openssl rand -hex 32
# PORTAL_TOKEN_SECRET=

# ── Sales Notifications ─────────────────────────────────────────────────────
# E-Mail/Slack-Webhook für Sales-Notifications bei neuen Registrierungen.
# SALES_NOTIFY_EMAIL=
# SALES_SLACK_WEBHOOK_URL=

# ── WorkOS (SSO/SAML) ───────────────────────────────────────────────────────
# Für Enterprise SSO. WorkOS API Key und Client ID aus dem WorkOS Dashboard.
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# ── Legal Brain ID (Legacy/Single-Tenant) ───────────────────────────────────
# Optional: feste Brain-ID für Legal-Features, wenn nicht pro-User geroutet.
# LEGAL_BRAIN_ID=

# ── Auth Database URL (Alias) ───────────────────────────────────────────────
# Alternative Env-Var für die Auth-DB (gleiche Funktion wie SUBSUMIO_AUTH_DATABASE_URL).
# AUTH_DB_URL=

# ── Hintergrund-Dokumentanalysen ────────────────────────────────────────────
# Höchstzahl Dokumentanalysen ohne Sitzung (Upload-Nacharbeit, Retry-Cron) pro
# Kanzlei und Tag — Schutz vor unkontrollierten Modellkosten. Default 300.
# SUBSUMIO_INTERNAL_ANALYSIS_DAILY_CAP=300

# ── Internal API Key (Service-zu-Service) ───────────────────────────────────
# Alternative zu SUBSUMIO_INTERNAL_SECRET für interne API-Calls.
# INTERNAL_API_KEY=

# ── GBRAIN Source (Engine-Bezug) ────────────────────────────────────────────
# Optional: Source-ID für den Engine-Bezug (Multi-Source-Setups).
# GBRAIN_SOURCE=

# ── Sentry DSN (Server-side) ────────────────────────────────────────────────
# Server-seitiger Sentry DSN (separat von NEXT_PUBLIC_SENTRY_DSN).
# SENTRY_DSN=

# ── WebSocket URL (Realtime) ────────────────────────────────────────────────
# Öffentliche WS-URL für Realtime-Features (Presence, Live-Updates).
# NEXT_PUBLIC_WS_URL=

# ── Engine Repo URL (Public) ────────────────────────────────────────────────
# Öffentliche URL des Engine-Repos für Doku/Links.
# NEXT_PUBLIC_ENGINE_REPO_URL=

# ── Direct Upload Max Bytes ─────────────────────────────────────────────────
# Client-seitiges Limit für Direct-Uploads (Bytes). Default: 1073741824 (1GB).
# NEXT_PUBLIC_DIRECT_UPLOAD_MAX_BYTES=1073741824

# ── WhatsApp Deadline Template ──────────────────────────────────────────────
# Meta-Template für Fristen-Benachrichtigung außerhalb des 24h-Fensters.
# WHATSAPP_DEADLINE_TEMPLATE=

# ── WhatsApp Signature Check (Dev) ──────────────────────────────────────────
# Nur Dev: Webhook-Signatur-Check deaktivieren. NIEMALS in Produktion setzen!
# WHATSAPP_SKIP_SIGNATURE_CHECK=false

# Emergency stop for all nightly Autopilot work.
DISABLE_AUTOPILOT_CRON=false
# Firm-wide maximum estimated AI spend per nightly run, in euro cents.
AUTOPILOT_NIGHTLY_BUDGET_CENTS=100
BANK_FEED_API_URL=
BANK_FEED_API_TOKEN=
BANK_FEED_IBAN=

# OpenRouter: NICHT mehr in der Web-App konfigurieren. Der Key liegt in der Engine
# (server/.env, OPENROUTER_API_KEY); die Web-App ruft Modelle nur über die Engine auf.

# ── E-Mail-Postfach (IMAP/SMTP) ─────────────────────────────────────────
# Optional OAuth sign-in for mailboxes whose provider disabled password logins.
# Redirect URI for both apps: ${NEXT_PUBLIC_APP_URL}/api/email/oauth/<microsoft|google>/callback
# Microsoft: multi-tenant Entra app with delegated IMAP.AccessAsUser.All, SMTP.Send, offline_access.
MAIL_OAUTH_MICROSOFT_CLIENT_ID=
MAIL_OAUTH_MICROSOFT_CLIENT_SECRET=
# Google: OAuth client (web) with scope https://mail.google.com/ (restricted scope → Google verification).
MAIL_OAUTH_GOOGLE_CLIENT_ID=
MAIL_OAUTH_GOOGLE_CLIENT_SECRET=
# Microsoft 365 calendar sync (cron/outlook-sync): firm that receives the events.
# The app-credential Graph routes (/api/outlook/mail|calendar) serve only this firm.
MS365_BRAIN_ID=

# ════════════════════════════════════════════════════════════════════════════
# Weitere Betriebs-Variablen (vollständig; geprüft von
# scripts/check-env-documented.ts). Alle optional, sofern nicht anders vermerkt.
# ════════════════════════════════════════════════════════════════════════════

# ── Interne Aufrufe & Proxy ─────────────────────────────────────────────────
# Origin, unter dem die Edge-Middleware den Sitzungs-Widerruf abfragt
# (/api/internal/revocation-check). Im Container http://localhost:3000 setzen —
# sonst läuft die Abfrage über die öffentliche Domain und teilt sich dort ein
# Rate-Limit für alle Nutzer. Fallback: NEXT_PUBLIC_SITE_URL.
# SUBSUMIO_INTERNAL_URL=http://localhost:3000
# Anzahl vertrauenswürdiger Reverse-Proxies vor der App (für Client-IP,
# IP-Allowlist, Rate-Limits). Caddy davor = 1. Default: 0.
# SUBSUMIO_TRUSTED_PROXY_HOPS=1
# Basis-URL für server-interne Folgeaufrufe (Analyse-Retry, Upload-Drain).
# Fallback: NEXT_PUBLIC_APP_URL.
# NEXTAUTH_URL=
# Alternative zu NEXT_PUBLIC_APP_URL für Kalender-Feed-Links.
# APP_URL=
# Alternative zu SUBSUMIO_API_URL (Engine-URL) für Code, der im Browser-Bundle
# landet. Normalerweise nicht nötig.
# NEXT_PUBLIC_SUBSUMIO_API_URL=
# Quelle, unter der der Betriebs-Health-Probe die Engine abfragt.
# Default: ops-health-probe.
# SUBSUMIO_MONITORING_SOURCE=ops-health-probe
# Brain-ID für systemweite Graph-Validierung. Default: system.
# SUBSUMIO_SYSTEM_BRAIN_ID=system
# Default-Rechtsraum für die Zitatprüfung, wenn keiner bekannt ist (at|de|ch).
# SUBSUMIO_DEFAULT_JURISDICTION=at
# Nur E2E-Tests: "1" = keine Secure-Cookies, keine Credit-Abbuchung. NIE in Produktion.
# SUBSUMIO_E2E=

# ── Betrieb: Backups & Korpus ───────────────────────────────────────────────
# Datei mit dem Zeitstempel des letzten erfolgreichen Backups (Health-Check).
# Compose setzt /backup-status/last-success.
# BACKUP_STATUS_FILE=
# Wurzel des lokalen Gesetzeskorpus (Alternative zu SUBSUMIO_LAW_CORPUS_DIR).
# LAW_CORPUS_ROOT=

# ── Datei-basierte Stores (nur Notfall/Einzelplatz) ─────────────────────────
# In Produktion verweigern API-Key-, Einwilligungs- und Fenster-Stores ohne
# Postgres den Start; "true" erlaubt ausnahmsweise Dateispeicher.
# SUBSUMIO_ALLOW_FILE_AUTH_IN_PRODUCTION=false
# Gleiches für das E-Mail-Postfach.
# SUBSUMIO_ALLOW_FILE_MAILBOX_IN_PRODUCTION=false

# ── Eingehende Webhooks & Telefonie ─────────────────────────────────────────
# Bearer-Key für /api/webhook/incoming (externe Systeme).
# SUBSUMIO_WEBHOOK_API_KEY=
# CTI-Webhook (Placetel/sipgate/3CX): Bearer-Secret und Ziel-Kanzlei.
# CTI_WEBHOOK_SECRET=
# CTI_BRAIN_ID=
# Für Anbieter ohne setzbaren Authorization-Header (sipgate.io, Placetel): Token im
# Pfad, Webhook-URL /api/cti/webhook/<token>. Je Token mind. 32 Zeichen; mehrere
# kommagetrennt für den Wechsel (alten erst nach Umstellung beim Anbieter entfernen).
# CTI_WEBHOOK_PATH_TOKENS=

# ── E-Rechnung (Zustellung) ─────────────────────────────────────────────────
# e-rechnung.gv.at (AT-Pflicht bei Bundesaufträgen): Endpunkt + Token.
# EINVOICE_ERV_URL=
# EINVOICE_ERV_TOKEN=
# PEPPOL-Access-Point: Endpunkt + Token.
# EINVOICE_PEPPOL_URL=
# EINVOICE_PEPPOL_TOKEN=

# ── Registrierkasse (RKSV) ──────────────────────────────────────────────────
# Signatur-Dienst für RKSV-Belege; ohne Konfiguration antwortet /api/legal/rksv 503.
# RKSV_ENDPOINT=
# RKSV_API_KEY=
# RKSV_CASH_REGISTER_ID=

# ── Rechtsschutzversicherung (Deckungsanfrage) ──────────────────────────────
# Provider-API; ohne Konfiguration wird die Anfrage per E-Mail-Entwurf gestellt.
# RSV_PROVIDER_ENDPOINT=
# RSV_PROVIDER_API_KEY=

# ── KYC / PEP-Prüfung ───────────────────────────────────────────────────────
# OpenSanctions-Lizenzschlüssel; ohne Key bleibt die PEP-Prüfung manuell.
# OPENSANCTIONS_API_KEY=
# OPENSANCTIONS_URL=https://api.opensanctions.org

# ── Push-Benachrichtigungen (Mobile App) ────────────────────────────────────
# iOS (APNs):
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY_PATH=
# Android (FCM HTTP v1): path to the Firebase service-account JSON file
# FCM_SERVICE_ACCOUNT_PATH=

# ── DE-Anbindungen ──────────────────────────────────────────────────────────
# Eigene beA-Safe-ID (erkennt eigene Nachrichten beim beA-Import).
# BEA_OWN_SAFE_ID=
# DATEV-Direktanbindung (alle drei nötig):
# DATEV_API_KEY=
# DATEV_CLIENT_ID=
# DATEV_CLIENT_SECRET=

# ── Website-Concierge & Live-Demo ───────────────────────────────────────────
# "1" = Concierge aus. Tageslimit an Antworten (Default 2000).
# CONCIERGE_DISABLED=
# CONCIERGE_DAILY_MAX=2000
# Empfänger für Leads aus dem Concierge (Default hello@subsum.io).
# CONCIERGE_LEAD_INBOX=
# Brain, aus dem der Concierge antwortet (Fallback SUBSUMIO_DEMO_BRAIN, dann "demo").
# SUBSUMIO_CONCIERGE_BRAIN=
# Vorlage, aus der jede Demo-Sitzung geklont wird (Default demo-template).
# SUBSUMIO_DEMO_TEMPLATE=demo-template
# Tageslimit an Demo-Fragen (Default 3000).
# DEMO_DAILY_MAX_QUESTIONS=3000
# Ab so vielen offenen Demo-Löschungen geht eine Warnmail raus (Default 50).
# DEMO_ALERT_PURGE_BACKLOG=50

# Idle timeout for sessions in hours (0 disables; default 12)
SUBSUMIO_SESSION_IDLE_HOURS=
# Signs WhatsApp Flow tokens (appointment contact binding); falls back to WHATSAPP_APP_SECRET
WHATSAPP_FLOW_TOKEN_SECRET=

# ── Datenbank-Pools / Sperren (optional) ──
# Größe des Auth-Pools (Sitzungen, Login, Audit, Rate-Limits). Standard 10.
# SUBSUMIO_AUTH_DB_POOL_MAX=10
# Eigener Pool für Vorgangs-Sperren (withKeyedLock). Standard 8.
# SUBSUMIO_KEYED_LOCK_POOL_MAX=8
# Wie lange eine Anfrage auf eine Sperre wartet, bevor sie 503 antwortet (ms). Standard 30000.
# SUBSUMIO_KEYED_LOCK_TIMEOUT_MS=30000

# ── Content-Security-Policy (optional) ──
# Zusätzliche Bild-Hosts für img-src (z. B. Objektspeicher), komma-getrennt.
# SUBSUMIO_CSP_IMG_HOSTS=https://files.example.at
