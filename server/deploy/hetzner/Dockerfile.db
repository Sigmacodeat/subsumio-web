# Custom DB image: pgvector + ParadeDB pg_search for BM25 scoring
FROM pgvector/pgvector:pg16

# Install ParadeDB pg_search extension
RUN apt-get update -qq && \
    apt-get install -y -qq wget ca-certificates && \
    wget -q "https://github.com/paradedb/paradedb/releases/download/v0.23.4/postgresql-16-pg-search_0.23.4-1PARADEDB-bookworm_amd64.deb" -O /tmp/pg_search.deb && \
    apt-get install -y -qq /tmp/pg_search.deb && \
    rm /tmp/pg_search.deb && \
    apt-get purge -y -qq wget && \
    apt-get autoremove -y -qq && \
    rm -rf /var/lib/apt/lists/*
