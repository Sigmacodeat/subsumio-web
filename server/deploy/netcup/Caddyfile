# Auto-HTTPS reverse proxy for the full Subsumio stack.
# APP_DOMAIN and ENGINE_DOMAIN must have DNS A-records pointing at this box
# BEFORE first boot — Caddy provisions Let's Encrypt certificates on demand.
#
# Body limit includes multipart overhead above the 500 MB file limit.
(common) {
	request_body {
		max_size 536870912
	}
}

# The web app's IP allowlist and audit rows read X-Real-IP first. Overwrite
# it with the TCP peer so a client-supplied value is never passed through.
# (Caddy already rewrites X-Forwarded-For for untrusted peers.)
(client-ip) {
	header_up X-Real-IP {remote_host}
}

# Long timeouts for legal-document uploads + server-side extraction.
(proxy-transport) {
	transport http {
		read_timeout 600s
		write_timeout 600s
		dial_timeout 30s
	}
}

{$APP_DOMAIN} {
	encode gzip
	import common
	reverse_proxy web:3000 {
		flush_interval -1
		import client-ip
		import proxy-transport
	}
}

# Operator console — same web container; the app only serves /ops and the
# operator APIs on this host (OPS_HOSTS). Session cookies are host-only, so a
# firm-app login never authenticates here.
{$OPS_DOMAIN} {
	encode gzip
	import common
	reverse_proxy web:3000 {
		import client-ip
		import proxy-transport
	}
}

{$ENGINE_DOMAIN} {
	encode gzip
	import common
	reverse_proxy engine:3131 {
		flush_interval -1
		import proxy-transport
	}
}

# Sanicura shop — auto-HTTPS reverse proxy
sanicura.com {
    encode zstd gzip br
    handle {
        reverse_proxy sanicura:4173 {
            flush_interval -1
            transport http {
                read_timeout 300s
                write_timeout 300s
                dial_timeout 30s
            }
        }
    }
}

www.sanicura.com {
    redir https://sanicura.com{uri} permanent
}
