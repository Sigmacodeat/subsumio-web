# ──────────────────────────────────────────────────────────────────────────
# Subsumio engine — Netcup production env. Copy to .env and fill in.
#   cp .env.example .env
# Generate secrets with:  openssl rand -hex 32
# NEVER commit .env (it holds live secrets).
# ──────────────────────────────────────────────────────────────────────────

# Public app + API hostnames (DNS A-records → this box). Caddy issues HTTPS.
APP_DOMAIN=subsum.io
ENGINE_DOMAIN=api.subsum.io
# Operator console (Subsumio staff only). DNS A-record → this box as well.
OPS_DOMAIN=ops.subsum.io
# Comma-separated staff e-mails allowed into the operator console. Accounts also
# need active 2FA. Empty = nobody (fail-closed).
PLATFORM_OPERATOR_EMAILS=

# Legal corpus on the host, OUTSIDE the git checkout (/opt/subsumio). A git pull
# would otherwise delete formerly tracked corpus files. Move once with
# move-corpus-out-of-repo.sh before pulling.
LAW_CORPUS_HOST_DIR=/opt/subsumio-data/law-corpus

# E-mail (Resend). Needed for password reset, portal links, low-balance alerts
# and the matter e-mail tab. The receiving domain must accept plus-addressing:
# firm inbound address = <local>+<brainId>@<domain> of MAIL_REPLY_TO/MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM="Subsumio <hello@subsum.io>"
MAIL_REPLY_TO=
# Resend inbound webhook -> https://<APP_DOMAIN>/api/email/webhook/resend
RESEND_WEBHOOK_SECRET=
# Brain id for unaddressed inbound mail (operator support mailbox)
EMAIL_INBOUND_DEFAULT_BRAIN_ID=subsumio-support

# Postgres credentials. User/DB default to "subsumio" — override if your
# existing volume was initialized with different names.
POSTGRES_USER=subsumio
POSTGRES_DB=subsumio
POSTGRES_PASSWORD=

# Shared secret between web and engine.  openssl rand -hex 32
SUBSUMIO_WEB_API_KEY=

# Engine → web internal webhook authentication. Required for atomic credit
# reservation/refund before every paid analysis. Generate independently.
ENGINE_WEBHOOK_API_KEY=

# Web session + encryption secrets.  openssl rand -hex 32
AUTH_SECRET=
SUBSUMIO_INTERNAL_SECRET=
SUBSUMIO_ENCRYPTION_KEY=

# Cron secret — protects all /api/cron/* endpoints. supercronic sends this as Bearer token.
CRON_SECRET=

# Signiert die Links zum Mandantenportal. PFLICHT in Produktion — ohne diesen
# Wert bricht die Web-App beim ersten Portal-Link mit einem Fehler ab.
# Eigenen Wert erzeugen (nicht AUTH_SECRET wiederverwenden):  openssl rand -hex 32
PORTAL_TOKEN_SECRET=

# Multi-tenant hardening — MANDATORY for SaaS (rejects any request without a tenant).
SUBSUMIO_REQUIRE_TENANT=true

# Behind Caddy → trust the proxy headers.
SUBSUMIO_HTTP_TRUST_PROXY=true

# CORS allow-list — the domains the browser calls from (comma-separated).
# Used by the engine for direct-to-engine browser uploads.
GBRAIN_HTTP_CORS_ORIGIN=https://subsum.io,https://www.subsum.io,https://subsum.io

# Public engine URL for browser direct uploads. The browser sends large files
# directly here. Must match ENGINE_DOMAIN + HTTPS.
NEXT_PUBLIC_ENGINE_URL=https://api.subsum.io

# Web app URL — used by the engine to fire post-upload callbacks (reconcile
# case documents, contradiction probe). Must be the internal Docker hostname
# on the box (e.g. http://web:3000) so the callback doesn't leave the host.
SUBSUMIO_WEB_URL=http://web:3000

# Large legal-document uploads. The self-hosted stack has no function body
# caps, so the browser and server can both advertise/accept 500 MB documents.
MAX_UPLOAD_BYTES=524288000
MAX_TABULAR_UPLOAD_BYTES=20971520
MAX_IMAGE_BYTES=209715200
NEXT_PUBLIC_DIRECT_UPLOAD_MAX_BYTES=524288000
# Multipart envelope includes headers/boundaries above the 500 MB file limit.
GBRAIN_MAX_UPLOAD_BYTES=536870912

# Optional ADVOKAT Local Bridge. Mount a read-only ADVOKAT export/document
# mirror from the Windows server (often via SMB/CIFS) into the engine.
ADVOKAT_IMPORT_HOST_PATH=./imports/advokat

# ── AI providers ──────────────────────────────────────────────────────────
# Einziger Ort für Provider-Keys: Engine + Korpus-Pipeline. Die Web-App ruft Modelle
# nur über die Engine auf (/api/think, /api/llm/complete, /api/llm/transcribe).
#
# Standard: Chat-Modelle direkt bei Anthropic (weniger Auftragsverarbeiter).
# SUBSUMIO_AI_PROVIDER leer lassen und ANTHROPIC_API_KEY setzen.
ANTHROPIC_API_KEY=
SUBSUMIO_AI_PROVIDER=
# Optional: OpenRouter als Ausweichweg — und Pflicht, wenn das Embedding-Modell
# unten über OpenRouter läuft. SUBSUMIO_AI_PROVIDER=openrouter leitet ALLE
# Chat-Aufrufe (auch die Legal-Pipeline) über OpenRouter; dann ist
# OPENROUTER_API_KEY Pflicht (preflight.sh prüft beides).
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FALLBACK=

# Embedding model — MUST be set explicitly. Without this the engine falls
# back to zeroentropyai:zembed-1 (1280d) which requires a ZEROENTROPY_API_KEY.
# OpenRouter's text-embedding-3-small (1536d) is the production default for
# Subsumio — it matches the law corpus embeddings and avoids dimension
# mismatch with existing chunks.
SUBSUMIO_EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small
SUBSUMIO_EMBEDDING_DIMENSIONS=1536

# ── KI nur in der EU (ÖRAK KI-Checkliste 2025, § 40 Abs 3 RL-BA) ─────────────
# Details: docs/architecture/LLM_GATEWAY.md, Abschnitt „EU-only".
#
# Anbieter-Modus. bedrock-eu = Claude über Amazon Bedrock, EU-Inferenzprofile
# (eu.anthropic.*) aus Frankfurt; Haiku 4.5 / Sonnet 5 / Opus 5 wie bisher.
# Für EU-Betrieb die Zeile SUBSUMIO_AI_PROVIDER=openrouter oben ersetzen:
# SUBSUMIO_AI_PROVIDER=bedrock-eu
#
# AWS-Zugang (IAM-Benutzer nur mit bedrock:InvokeModel* auf eu.anthropic.*).
# Entweder Schlüsselpaar (SigV4) …
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# … optional nur bei temporären STS-Zugangsdaten:
AWS_SESSION_TOKEN=
# … oder ein Bedrock-API-Schlüssel statt Schlüsselpaar:
AWS_BEARER_TOKEN_BEDROCK=
# Region: nur EU-Mitgliedsstaaten zählen als EU (eu-west-2 London und
# eu-central-2 Zürich NICHT — deren EU-Profil routet auch nach UK/CH).
AWS_REGION=eu-central-1
#
# Harter EU-Schalter: jeder KI-Aufruf (Chat, Completion, Stream, Transkription,
# Reranker, Query-Expansion/OCR) prüft den Verarbeitungsort; Nicht-EU-Anbieter
# werden abgelehnt (kein stilles Umleiten). Anthropic direkt, OpenAI, OpenRouter,
# Google, Groq, ZeroEntropy … gelten als Nicht-EU.
SUBSUMIO_EU_ONLY=0
# Embeddings: ein Modellwechsel heißt den ganzen Korpus neu einbetten. Darum
# sperrt EU_ONLY Embeddings NICHT, solange dieser zweite Schalter aus ist.
# =1 → Nicht-EU-Embedding für NEUE Dokumente (Dokumentseite) wird abgelehnt;
# Such-Anfragen bleiben erlaubt. Erst nach EU-Embedding-Migration einschalten.
# Korpus-Läufe mit öffentlichem Gesetzestext können ihn mit =0 überschreiben.
SUBSUMIO_EU_ONLY_EMBEDDINGS=0
#
# Nur setzen, wenn der Anbieter nachweislich in der EU verarbeitet (=eu):
# Azure-OpenAI-Ressource in EU-Region / Data Zone EU:
SUBSUMIO_AZURE_OPENAI_RESIDENCY=
# OpenRouter-Enterprise mit EU-In-Region-Routing (Vertrag!):
SUBSUMIO_OPENROUTER_RESIDENCY=
# LiteLLM-Proxy, dessen Backends alle in der EU laufen:
SUBSUMIO_LITELLM_RESIDENCY=
# Selbst gehostete Modelle (Ollama/llama.cpp) auf EU-Servern:
SUBSUMIO_SELF_HOSTED_RESIDENCY=
#
# OpenRouter bekommt IMMER data_collection=deny + zdr=true mitgeschickt (kein
# Speichern/Training beim Endanbieter). =off nimmt nur zdr weg — nötig z. B. für
# Fable 5.1, das keinen ZDR-Endpunkt hat. Standard: leer lassen.
SUBSUMIO_OPENROUTER_ZDR=
#
# Kritiker-Ensemble der Rechtspipeline: Standard enthält Anthropic direkt +
# OpenRouter. Unter EU_ONLY auf EU-Modelle stellen, sonst lehnt die Pipeline ab:
# SUBSUMIO_ENSEMBLE_CRITIC_MODELS=bedrock:eu.anthropic.claude-opus-5,bedrock:eu.anthropic.claude-sonnet-5,bedrock:eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Document OCR — REQUIRED for a law firm. Scanned/photographed documents arrive
# as images; without this they have no searchable/chattable text. OCR output is
# auto-tagged `extraction_unverified`. Uses OpenRouter vision models.
SUBSUMIO_EMBEDDING_IMAGE_OCR=true
# Shared statute corpus every tenant reads alongside their own files.
# Import via: import-statutes-split.ts --source law-at / law-de / law-ch / law-eu
# Read-only federation — never widens write scope. Public text → no isolation risk.
SUBSUMIO_SHARED_READ_SOURCES=law-at,law-de,law-ch,law-eu

# ── Optional: S3-compatible object storage for original file bytes (GoBD) ──────
# Supports Cloudflare R2, MinIO, or AWS S3 — any S3-compatible backend.
# Without this, files land on the engine-data volume (fine for pilots).
#
# S3-compatible example:
#   R2_ENDPOINT=https://<endpoint>                    # provider endpoint
#   R2_BUCKET=subsumio-vault
#   R2_ACCESS_KEY_ID=<access key>
#   R2_SECRET_ACCESS_KEY=<secret key>
#   R2_REGION=us-east-1                               # SDK requires a value
#
# Cloudflare R2 example:
#   R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   R2_BUCKET=subsumio-vault
#   R2_ACCESS_KEY_ID=<access key>
#   R2_SECRET_ACCESS_KEY=<secret key>
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=us-east-1

# Disabled until S3-backed persistent upload sessions and streaming confirm are
# enabled and load-tested. The normal direct-to-engine upload remains active.
SUBSUMIO_PRESIGNED_UPLOAD_ENABLED=false

# Tenant/brain receiving documents from the installation-level ADVOKAT mirror.
# Required for SaaS; obtain it from the firm's user/org record.
ADVOKAT_TARGET_SOURCE_ID=

# ──────────────────────────────────────────────────────────────────────────
# Offsite backup (restic) — encrypted DB + original-file backups off the VM.
# Production gate requires this; leaving it blank is allowed only for local pilots.
# Restore + verification: see deploy/netcup/backup/ and docs/BACKUP-RESTORE-PLAN.md.
#
# IMPORTANT: store BACKUP_RESTIC_PASSWORD OFFLINE too (password manager + paper).
# Without it the encrypted backups are unrecoverable — losing the VM AND the
# password means total data loss.
#
# Pick ONE offsite target (use a DIFFERENT provider/location than the VM):
#
#  A) S3-compatible object storage — RECOMMENDED (enable versioning /
#     object-lock on the bucket for ransomware resistance):
#       BACKUP_RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/restic
#       BACKUP_S3_ACCESS_KEY_ID=<key>
#       BACKUP_S3_SECRET_ACCESS_KEY=<secret>
#
#  B) SFTP storage (e.g. a storage box) — cheapest. Needs an SSH key mounted
#     into the backup container + a known_hosts entry. Then:
#       BACKUP_RESTIC_REPOSITORY=sftp:<user>@<host>:/restic
#     (AWS_* not used in this mode.)
#
# Generate the password with:  openssl rand -base64 48
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────────────────────────────────
# At-rest encryption of original files (envelope: per-file AES-256-GCM DEK,
# wrapped by this KEK). REQUIRED in production: the data processing agreement
# promises encrypted originals, preflight.sh refuses an empty value and the
# engine warns at startup without it. Enabling is SAFE + non-destructive:
# existing files stay readable, only newly written files get encrypted — files
# stored before the key was set remain plaintext until re-encrypted (operator
# step). restic backups are already encrypted independently.
#
# IMPORTANT: store this key OFFLINE too — losing the volume AND this key means the
# encrypted originals are unrecoverable. (The restic backup password is separate.)
#
# Generate with:  openssl rand -base64 32   (must decode to exactly 32 bytes)
SUBSUMIO_STORAGE_ENCRYPTION_KEY=
SUBSUMIO_STORAGE_ENCRYPTION_KEY_ID=k1
# Key rotation: set a NEW active key + id above, move the OLD one here so older
# files still decrypt. JSON {"<old-id>":"<old-base64-key>"}.
SUBSUMIO_STORAGE_ENCRYPTION_RETIRED_KEYS=

# Legal corpus directory (data dir on the host, outside the app tree)
SUBSUMIO_LAW_CORPUS_DIR=/var/lib/subsumio/law-corpus

# ── Engine error tracking (Sentry, optional) ─────────────────────────────
# DSN of a Sentry project for the ENGINE (the web app uses NEXT_PUBLIC_SENTRY_DSN).
# Empty = disabled. Only error type/message/stack + job/request ids are sent,
# never prompts or document text. See server/src/core/error-report.ts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Spend cap per supervisor agent run in cents (default 300 = 3 USD).
SUBSUMIO_AGENT_DEFAULT_BUDGET_CENTS=300

# ──────────────────────────────────────────────────────────────────────────
# Web-App — optionale Funktionen. Leer = Funktion aus; preflight.sh warnt.
# ──────────────────────────────────────────────────────────────────────────

# Fehlerüberwachung der Web-App (Sentry). ACHTUNG: NEXT_PUBLIC_*-Werte werden
# beim Build in das Image eingebacken. Damit der Wert wirkt, muss er auch als
# Build-Argument an Dockerfile.web übergeben werden (docker-compose.yml, web.build.args).
# Auftragsverarbeiter — steht in Datenschutzerklärung und AVV.
NEXT_PUBLIC_SENTRY_DSN=

# Kanzleiwissen (Brain-ID), in dem Anfragen aus dem öffentlichen
# Erstanfrage-Formular landen. Leer = Fallback WHATSAPP_DEFAULT_BRAIN_ID, sonst aus.
SUBSUMIO_PUBLIC_INTAKE_BRAIN_ID=
# Kanzleiwissen (Brain-ID) für die öffentliche Terminbuchung. Leer = Buchung aus.
SUBSUMIO_PUBLIC_BOOKING_BRAIN_ID=

# Online-Abrechnung über Stripe (src/app/api/billing/**). Ohne Schlüssel sind
# Checkout und Kundenportal deaktiviert.
STRIPE_SECRET_KEY=
# Webhook-Signaturschlüssel -> https://<APP_DOMAIN>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Preis-IDs (price_...) der Tarife Solo und Kanzlei.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_KANZLEI=
# Optional: Preis-IDs für Credit-Pakete.
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=

# Web-Push (VAPID) für Benachrichtigungen im Browser und im Mandantenportal.
# Erzeugen mit:  npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@subsum.io

# DocuSign. Ohne DOCUSIGN_BASE_URL nutzt der Code die DEMO-Umgebung
# (https://demo.docusign.net/restapi/v2.1) — dort erzeugte Signaturen sind nicht
# rechtsgültig. Für Produktion die Basis-URL Ihres DocuSign-Kontos eintragen
# (Form: https://<Konto-Host>.docusign.net/restapi/v2.1).
DOCUSIGN_BASE_URL=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=

# ──────────────────────────────────────────────────────────────────────────
# Ressourcengrenzen pro Dienst (docker-compose.yml). Leer = Standardwert dort.
# Die Datenbank hat bewusst keine Grenze; alle anderen sind gedeckelt, damit ein
# Ausreißer (große OCR, Pipeline-Leck) nicht die DB in den OOM-Killer drückt.
# Nach Änderung prüfen: docker stats --no-stream
# ──────────────────────────────────────────────────────────────────────────
ENGINE_MEM_LIMIT=
ENGINE_CPUS=
ENGINE_PIDS_LIMIT=
PIPELINE_MEM_LIMIT=
PIPELINE_CPUS=
PIPELINE_PIDS_LIMIT=
WEB_MEM_LIMIT=
WEB_CPUS=
CLAMAV_MEM_LIMIT=

# ──────────────────────────────────────────────────────────────────────────
# Cron-Überwachung (cronjob.sh, RUNBOOK "Cron-Überwachung").
# Fehlgeschlagene Jobs mailen an QUEUE_ALERT_EMAIL (über RESEND_API_KEY, höchstens
# einmal pro Job und Stunde). Heartbeat-URLs (Healthchecks.io, Uptime Kuma …)
# werden nach jedem ERFOLGREICHEN Lauf aufgerufen; bleibt der Ping aus, alarmiert
# der externe Dienst. Leer = kein Ping.
# Die Korpus-Pipeline (Delta-Sync, Index-Crawls) mailt Fehler-Alarme ebenfalls an
# QUEUE_ALERT_EMAIL (höchstens einmal pro Quelle/Typ alle 6 h) und schickt jeden
# Alarm zusätzlich an ALERT_WEBHOOK, falls gesetzt (JSON-POST). Leer = kein Webhook.
# ──────────────────────────────────────────────────────────────────────────
QUEUE_ALERT_EMAIL=
ALERT_WEBHOOK=
CRON_HEARTBEAT_URL_DEADLINES=
CRON_HEARTBEAT_URL_DEADLINE_REMINDERS=
CRON_HEARTBEAT_URL_DEADLINE_ALERTS=
CRON_HEARTBEAT_URL_HEALTH=
CRON_HEARTBEAT_URL_APPOINTMENT_REMINDERS=
CRON_HEARTBEAT_URL_IMAP_SYNC=
CRON_HEARTBEAT_URL_DUNNING_RUN=
CRON_HEARTBEAT_URL_MONTHLY_INVOICE=
CRON_HEARTBEAT_URL_SANCTIONS_SYNC=
